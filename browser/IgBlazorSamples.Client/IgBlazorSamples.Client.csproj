<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
 
    <!-- note copied Nullable/ImplicitUsings from a new Blazor project that targets .NET 6 -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <RazorLangVersion>3.0</RazorLangVersion>
    <AssemblyName>Infragistics.Samples</AssemblyName>
    <RootNamespace>Infragistics.Samples</RootNamespace>
    <Version>4.0.0</Version>
    <!-- this is required for excel WASM samples for fast file download -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;NU1803,IDE0028,BL0005,0219,CS1998,0219l,RSG002,CS8618,CS8612,CS8625,CS8601,CS8602,CS0219,CS8600,CS8622,CS8603,CS8604,CS8605</NoWarn>
    <OutputPath>output</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;NU1803,IDE0028,BL0005,0219,CS1998,0219l,RSG002,CS8618,CS8612,CS8625,CS8601,CS8602,CS0219,CS8600,CS8622,CS8603,CS8604,CS8605</NoWarn>
  </PropertyGroup>

    <!--<IsAotCompatible>true</IsAotCompatible>-->
  <PropertyGroup>
      <IsTrimable>false</IsTrimable>
      <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
      <PublishTrimmed>true</PublishTrimmed>
      <TrimMode>partial</TrimMode>
  </PropertyGroup>
  
    <Target Name="DebugEnsureNodeEnv" BeforeTargets="Build" Condition=" '$(Configuration)' == 'Debug' And !Exists('$(NpmRoot)node_modules') ">
        <Exec Command="node --version" ContinueOnError="true">
            <Output TaskParameter="ExitCode" PropertyName="ErrorCode" />
        </Exec>
        <Error Condition="'$(ErrorCode)' != '0'" Text="Node.js is required to build and run this project. To continue, please install Node.js from https://nodejs.org/, and then restart your command prompt or IDE." />
        <Message Importance="high" Text="Restoring dependencies using 'npm'. This may take several minutes..." />
    </Target>

    <ItemGroup>
      <None Remove="notes.txt" />
    </ItemGroup>

    <!--
      The deployed site is publish/wwwroot, and wwwroot/web.config serves its pre-compressed
      .br/.gz sidecars. Copy it after publish so it wins over any web.config the SDK writes.
    -->
    <Target Name="EnsureCustomWebConfigInPublish" AfterTargets="Publish">
      <Copy SourceFiles="$(MSBuildProjectDirectory)/wwwroot/web.config" DestinationFiles="$(PublishDir)wwwroot/web.config" OverwriteReadOnlyFiles="true" />
    </Target>

    <!-- End NPM Updates -->

  <ItemGroup>
    <PackageReference Include="IgniteUI.Blazor.Trial" Version="26.2.2" />
    <PackageReference Include="IgniteUI.Blazor.Documents.Core.Trial" Version="26.2.2" />
    <PackageReference Include="IgniteUI.Blazor.Documents.Excel.Trial" Version="26.2.2" />
    <PackageReference Include="IgniteUI.Blazor.GridLite" Version="1.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.1" />
    <PackageReference Include="Microsoft.JSInterop.WebAssembly" Version="10.0.1" />
    <PackageReference Include="System.Net.Http.Json" Version="10.0.1" />
  </ItemGroup>

  <!--
    The Excel library loads only on /excel/ routes (App.razor loads every assembly listed here).
  -->
  <ItemGroup>
      <BlazorWebAssemblyLazyLoad Include="IgniteUI.Blazor.Documents.Core.wasm" />
      <BlazorWebAssemblyLazyLoad Include="IgniteUI.Blazor.Documents.Excel.wasm" />
  </ItemGroup>
  <!--
    After trimming, only the Excel library references these, so the published app loads them with
    it and the other samples don't download them. Without trimming (dotnet build, run or watch),
    other assemblies still reference some of them at startup, e.g. the System.Threading.Thread
    facade, so those builds keep loading them up front.
  -->
  <ItemGroup Condition="'$(_IsPublishing)' == 'true' And '$(PublishTrimmed)' == 'true'">
      <BlazorWebAssemblyLazyLoad Include="HarfBuzzSharp.wasm" />
      <BlazorWebAssemblyLazyLoad Include="Microsoft.Win32.Primitives.wasm" />
      <BlazorWebAssemblyLazyLoad Include="Microsoft.Win32.SystemEvents.wasm" />
      <BlazorWebAssemblyLazyLoad Include="SkiaSharp.wasm" />
      <BlazorWebAssemblyLazyLoad Include="System.ComponentModel.Annotations.wasm" />
      <BlazorWebAssemblyLazyLoad Include="System.Diagnostics.Process.wasm" />
      <BlazorWebAssemblyLazyLoad Include="System.Drawing.Common.wasm" />
      <BlazorWebAssemblyLazyLoad Include="System.IO.Compression.wasm" />
      <BlazorWebAssemblyLazyLoad Include="System.IO.Packaging.wasm" />
      <BlazorWebAssemblyLazyLoad Include="System.Net.Requests.wasm" />
      <BlazorWebAssemblyLazyLoad Include="System.Net.WebClient.wasm" />
      <BlazorWebAssemblyLazyLoad Include="System.Net.WebProxy.wasm" />
      <BlazorWebAssemblyLazyLoad Include="System.Numerics.Vectors.wasm" />
      <BlazorWebAssemblyLazyLoad Include="System.Private.Windows.Core.wasm" />
      <BlazorWebAssemblyLazyLoad Include="System.Private.Windows.GdiPlus.wasm" />
      <BlazorWebAssemblyLazyLoad Include="System.Private.Xml.wasm" />
      <BlazorWebAssemblyLazyLoad Include="System.Reflection.Metadata.wasm" />
      <BlazorWebAssemblyLazyLoad Include="System.Runtime.Serialization.Formatters.wasm" />
      <BlazorWebAssemblyLazyLoad Include="System.Security.AccessControl.wasm" />
      <BlazorWebAssemblyLazyLoad Include="System.Security.Principal.Windows.wasm" />
      <BlazorWebAssemblyLazyLoad Include="System.Text.Encoding.Extensions.wasm" />
      <BlazorWebAssemblyLazyLoad Include="System.Threading.Thread.wasm" />
      <BlazorWebAssemblyLazyLoad Include="System.Xml.ReaderWriter.wasm" />
      <BlazorWebAssemblyLazyLoad Include="Topten.RichTextKit.wasm" />
  </ItemGroup>

  <!-- Gives App.razor the list above, so it loads exactly the assemblies this build marks as lazy -->
  <Target Name="EmbedLazyLoadAssemblyList" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BlazorWebAssemblyLazyLoad</_Parameter1>
        <_Parameter2>@(BlazorWebAssemblyLazyLoad)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\IgBlazorSamples.Core\IgBlazorSamples.Core.csproj" />
    <ProjectReference Include="..\IgBlazorSamples.Shared\IgBlazorSamples.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Services\" />
    <Folder Include="wwwroot\js\" />
  </ItemGroup>

</Project>
