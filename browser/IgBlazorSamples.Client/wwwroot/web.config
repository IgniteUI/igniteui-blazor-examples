<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for the Blazor WebAssembly samples browser (IgBlazorSamples.Client).

  The deployed site is the content of publish/wwwroot (see the ArchiveFiles step in
  azure-pipelines/templates/build-steps-template.yml), served as static files from the
  /blazor-client IIS application. EnsureCustomWebConfigInPublish in
  IgBlazorSamples.Client.csproj copies this file into publish/wwwroot. The same approach
  is used by IgniteUI/blazor-grid-examples.

  PRE-COMPRESSED SIDECARS
  dotnet publish writes a Brotli (.br) and a gzip (.gz) copy next to almost every file in
  wwwroot: _framework, _content, sb, code-viewer, toc.json, index.html. The rewrite rules
  below serve the .br copy to clients that accept Brotli and the .gz copy to the rest, so
  IIS does no compression work at request time. Brotli at publish time compresses the
  .wasm files to about a quarter of their size, well below what gzip or edge compression
  achieves.

  REQUIREMENTS
  - IIS URL Rewrite Module 2.x.
  - RESPONSE_CONTENT_ENCODING must be an allowed server variable (applicationHost.config
    level). The staging and production servers already allow it for blazor-grid-examples,
    which is deployed to the same IIS sites.
-->
<configuration>
  <system.webServer>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!--
      MIME types. The <remove> guards prevent HTTP 500.19 where a type is already defined
      at a parent level. .br and .gz must be registered or the static file handler returns
      404.3 for the sidecars; the outbound rules below restore each sidecar's real type.
    -->
    <staticContent>
      <remove fileExtension=".blat" />
      <mimeMap fileExtension=".blat" mimeType="application/octet-stream" />
      <remove fileExtension=".dat" />
      <mimeMap fileExtension=".dat" mimeType="application/octet-stream" />
      <remove fileExtension=".dll" />
      <mimeMap fileExtension=".dll" mimeType="application/octet-stream" />
      <remove fileExtension=".webcil" />
      <mimeMap fileExtension=".webcil" mimeType="application/octet-stream" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".br" />
      <mimeMap fileExtension=".br" mimeType="application/octet-stream" />
      <remove fileExtension=".gz" />
      <mimeMap fileExtension=".gz" mimeType="application/octet-stream" />
    </staticContent>

    <!--
      Fallback for the few files without a sidecar and for clients that accept neither br
      nor gzip sidecars. IIS excludes application/wasm, application/json and image/svg+xml
      from static compression by default.
    -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />
    <httpCompression>
      <staticTypes>
        <remove mimeType="application/wasm" />
        <add mimeType="application/wasm" enabled="true" />
        <remove mimeType="application/json" />
        <add mimeType="application/json" enabled="true" />
        <remove mimeType="image/svg+xml" />
        <add mimeType="image/svg+xml" enabled="true" />
      </staticTypes>
    </httpCompression>

    <rewrite>
      <rules>
        <!-- Serve <file>.br with Content-Encoding: br when the client accepts Brotli. -->
        <rule name="Brotli pre-compressed" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="br" />
            <add input="{REQUEST_FILENAME}.br" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:0}.br" />
          <serverVariables>
            <set name="RESPONSE_CONTENT_ENCODING" value="br" />
          </serverVariables>
        </rule>

        <!-- Otherwise serve <file>.gz with Content-Encoding: gzip. -->
        <rule name="Gzip pre-compressed" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="gzip" />
            <add input="{REQUEST_FILENAME}.gz" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:0}.gz" />
          <serverVariables>
            <set name="RESPONSE_CONTENT_ENCODING" value="gzip" />
          </serverVariables>
        </rule>

        <!--
          The app routes client-side, so a deep link such as /blazor-client/samples/grids/grid/overview
          has no file behind it: serve index.html. The URL is relative to this file's folder,
          so it resolves to the application's index.html wherever the site is mounted.
        -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>

      <!--
        A sidecar is served with the .br/.gz MIME type (application/octet-stream). Restore the
        original file's type: browsers reject module scripts and stylesheets with the wrong
        type, and WebAssembly.instantiateStreaming requires application/wasm.
        Vary: Accept-Encoding keeps the nginx and CloudFront caches in front of IIS from
        replaying a Brotli body to a client that can't decode it. IIS adds Vary for its own
        compression, but not for responses these rules rewrite.
      -->
      <outboundRules>
        <rule name="Vary for compressed sidecars" preCondition="IsCompressedSidecar">
          <match serverVariable="RESPONSE_Vary" pattern=".*" />
          <action type="Rewrite" value="Accept-Encoding" />
        </rule>
        <rule name="ContentType compressed wasm" preCondition="IsCompressedWasm">
          <match serverVariable="RESPONSE_CONTENT_TYPE" pattern=".*" />
          <action type="Rewrite" value="application/wasm" />
        </rule>
        <rule name="ContentType compressed js" preCondition="IsCompressedJs">
          <match serverVariable="RESPONSE_CONTENT_TYPE" pattern=".*" />
          <action type="Rewrite" value="text/javascript" />
        </rule>
        <rule name="ContentType compressed css" preCondition="IsCompressedCss">
          <match serverVariable="RESPONSE_CONTENT_TYPE" pattern=".*" />
          <action type="Rewrite" value="text/css" />
        </rule>
        <rule name="ContentType compressed json" preCondition="IsCompressedJson">
          <match serverVariable="RESPONSE_CONTENT_TYPE" pattern=".*" />
          <action type="Rewrite" value="application/json" />
        </rule>
        <rule name="ContentType compressed svg" preCondition="IsCompressedSvg">
          <match serverVariable="RESPONSE_CONTENT_TYPE" pattern=".*" />
          <action type="Rewrite" value="image/svg+xml" />
        </rule>
        <rule name="ContentType compressed html" preCondition="IsCompressedHtml">
          <match serverVariable="RESPONSE_CONTENT_TYPE" pattern=".*" />
          <action type="Rewrite" value="text/html" />
        </rule>
        <preConditions>
          <preCondition name="IsCompressedSidecar">
            <add input="{REQUEST_FILENAME}" pattern="\.(br|gz)$" />
          </preCondition>
          <preCondition name="IsCompressedWasm">
            <add input="{REQUEST_FILENAME}" pattern="\.wasm\.(br|gz)$" />
          </preCondition>
          <preCondition name="IsCompressedJs">
            <add input="{REQUEST_FILENAME}" pattern="\.js\.(br|gz)$" />
          </preCondition>
          <preCondition name="IsCompressedCss">
            <add input="{REQUEST_FILENAME}" pattern="\.css\.(br|gz)$" />
          </preCondition>
          <preCondition name="IsCompressedJson">
            <add input="{REQUEST_FILENAME}" pattern="\.json\.(br|gz)$" />
          </preCondition>
          <preCondition name="IsCompressedSvg">
            <add input="{REQUEST_FILENAME}" pattern="\.svg\.(br|gz)$" />
          </preCondition>
          <preCondition name="IsCompressedHtml">
            <add input="{REQUEST_FILENAME}" pattern="\.html\.(br|gz)$" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

  </system.webServer>
</configuration>
