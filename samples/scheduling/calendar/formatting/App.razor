@using IgniteUI.Blazor.Controls


<div class="container vertical">
    <IgbRadioGroup Alignment="ContentOrientation.Horizontal" @bind-Value="CalendarLocale">
        <IgbRadio name="lang" Value="@("en")">EN</IgbRadio>
        <IgbRadio name="lang" Value="@("de")">DE</IgbRadio>
        <IgbRadio name="lang" Value="@("fr")">FR</IgbRadio>
        <IgbRadio name="lang" Value="@("ar")">AR</IgbRadio>
        <IgbRadio name="lang" Value="@("ja")">JA</IgbRadio>
    </IgbRadioGroup>

    <div style="width: 25rem; border: 1px solid gainsboro;">
        <IgbCalendar @bind-Value="date" FormatOptions="@CalendarFormat" Locale=@CalendarLocale WeekStart="@WeekDays.Monday" />
    </div>
</div>

@code {

    private string CalendarLocale { get; set; }
    private IgbCalendarFormatOptions CalendarFormat { get; set; }
    private DateTime date = DateTime.Today;

    protected override void OnInitialized()
    {
        this.CalendarLocale = "en";
        this.CalendarFormat = new IgbCalendarFormatOptions() { Month = "short", Weekday = "short" };
    }
}