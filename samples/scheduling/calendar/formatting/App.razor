@using IgniteUI.Blazor.Controls


<div class="container vertical">
    <IgbRadioGroup TValue="string" Alignment="ContentOrientation.Horizontal">
        <IgbRadio TValue="string" name="lang" Value="@("en")" Checked="true" Change="OnRadioOptionClick">EN</IgbRadio>
        <IgbRadio TValue="string" name="lang" Value="@("de")" Change="OnRadioOptionClick">DE</IgbRadio>
        <IgbRadio TValue="string" name="lang" Value="@("fr")" Change="OnRadioOptionClick">FR</IgbRadio>
        <IgbRadio TValue="string" name="lang" Value="@("ar")" Change="OnRadioOptionClick">AR</IgbRadio>
        <IgbRadio TValue="string" name="lang" Value="@("ja")" Change="OnRadioOptionClick">JA</IgbRadio>
    </IgbRadioGroup>

    <div style="width: 25rem; border: 1px solid gainsboro;">
        <IgbCalendar TValue="DateTime" FormatOptions="@CalendarFormat" Locale=@CalendarLocale WeekStart="@WeekDays.Monday" />
    </div>
</div>

@code {

    private string CalendarLocale { get; set; }
    private IgbCalendarFormatOptions CalendarFormat { get; set; }

    protected override void OnInitialized()
    {
        this.CalendarLocale = "en";
        this.CalendarFormat = new IgbCalendarFormatOptions() { Month = "short", Weekday = "short" };
    }

    public void OnRadioOptionClick(IgbRadioChangeEventArgs<string> e)
    {
        this.CalendarLocale = e.Detail.Value;

        StateHasChanged();
    }
}