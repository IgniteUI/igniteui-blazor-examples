@using IgniteUI.Blazor.Controls


<div class="container vertical">
    <IgbRadioGroup TValue="string" Alignment="@ContentOrientation.Horizontal">
        <IgbRadio TValue="string" name="size" Value="@("Small")" label-position="after" Change="OnRadioOptionClick">Small</IgbRadio>
        <IgbRadio TValue="string" name="size" Value="@("Medium")" label-position="after" Checked="true" Change="OnRadioOptionClick">Medium</IgbRadio>
        <IgbRadio TValue="string" name="size" Value="@("Large")" label-position="after" Change="OnRadioOptionClick">Large</IgbRadio>
    </IgbRadioGroup>

    <div style="width: 25rem; border: 1px solid gainsboro;">
        <IgbCalendar TValue="DateTime" class="@CalendarSize"/>
    </div>
</div>

@code {
    private string CalendarSize = "size-medium";

    public void OnRadioOptionClick(IgbRadioChangeEventArgs<string> e)
    {
        this.CalendarSize = $"size-{e.Detail.Value.ToLower()}";
    }
}