@using IgniteUI.Blazor.Controls


<div class="container vertical">
    <div class="container vertical">
        <IgbDateRangePicker TValue="DateTime" @ref="DateRangePicker" Value="@Range" Label="Date Range" />
    </div>
</div>

@code {

    public IgbDateRangePicker<DateTime> DateRangePicker { get; set; }

    public IgbDateRangeValue<DateTime> Range = new IgbDateRangeValue<DateTime>()
    {
        Start = DateTime.Today,
        End = DateTime.Today.AddDays(3)
    };
}
