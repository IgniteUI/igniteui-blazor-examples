@using IgniteUI.Blazor.Controls


<div class="container vertical">
    <div class="container vertical">
        <IgbDateRangePicker TValue="DateTime" @ref="DateRangePicker" CustomRanges="@CustomRanges" Mode="PickerMode.Dialog" UsePredefinedRanges="true" Label="Custom Ranges" />
    </div>
</div>

@code {

    public IgbDateRangePicker<DateTime> DateRangePicker { get; set; }

    public IgbCustomDateRange<DateTime>[] CustomRanges = [
            new IgbCustomDateRange<DateTime>()
            {
                Label = "Previous 7 Days",
                DateRange = new IgbDateRangeValue<DateTime>()
                {
                    Start = DateTime.Today.AddDays(-7),
                    End = DateTime.Today
                }
            },
            new IgbCustomDateRange<DateTime>()
            {
                Label = "Next 7 Days",
                DateRange = new IgbDateRangeValue<DateTime>()
                {
                    Start = DateTime.Today,
                    End = DateTime.Today.AddDays(7)
                }
            }
    ];
}
