        },
        new AvatarListSection
        {
            Header = "Meetings",
            Items = new List<AvatarListItem>
            {
                new AvatarListItem
                {
                    Title = "Weekly Meeting",
                    Subtitle = "https://www.infra.com",
                    End = "Monday",
                    Avatar = new AvatarData
                    {
                        Icon = "calendar",
                        Alt = "Calendar icon."
                    }
