@using IgniteUI.Blazor.Controls

<div class="avatar-size-sample">
    <div class="avatar-variant">
        <span class="avatar-with-badge">
            <IgbAvatar
                class="size-large"
                Shape=AvatarShape.Circle
                Src="https://dl.infragistics.com/x/img/avatars/avatar-profile-05.png"
                Alt="A profile photo of a man." />
            <IgbBadge
                class="avatar-status size-large"
                Dot="true"
                Outlined="true"
                Variant="@StyleVariant.Success" />
        </span>
        <span class="avatar-label">Large</span>
    </div>

    <div class="avatar-variant">
        <span class="avatar-with-badge">
            <IgbAvatar
                class="size-medium"
                Shape=AvatarShape.Circle
                Src="https://dl.infragistics.com/x/img/avatars/avatar-profile-03.png"
                Alt="A profile photo of a man." />
            <IgbBadge
                class="avatar-status size-medium"
                Dot="true"
                Outlined="true"
                Variant="@StyleVariant.Success" />
        </span>
        <span class="avatar-label">Medium</span>
    </div>

    <div class="avatar-variant">
        <span class="avatar-with-badge">
            <IgbAvatar
                class="size-small"
                Shape=AvatarShape.Circle
                Src="https://dl.infragistics.com/x/img/avatars/avatar-profile-04.png"
                Alt="A profile photo of a man." />
            <IgbBadge
                class="avatar-status size-small"
                Dot="true"
                Outlined="true"
                Variant="@StyleVariant.Success" />
        </span>
        <span class="avatar-label">Small</span>
    </div>
</div>

