@using IgniteUI.Blazor.Controls


<div class="container vertical">   
   <label>Step type</label>
   <div class="radio-group-container">
        <IgbRadioGroup TValue="string" Alignment="ContentOrientation.Horizontal">
            <IgbRadio TValue="string" name="type" Value="@("indicator")" Change="onStepTypeChange">Indicator</IgbRadio>
            <IgbRadio TValue="string" name="type" Value="@("title")" Change="onStepTypeChange">Title</IgbRadio>
            <IgbRadio TValue="string" name="type" Value="@("full")" Checked="true" Change="onStepTypeChange">Full</IgbRadio>
        </IgbRadioGroup>
   </div>  

   <IgbStepper Name="stepper" @ref="stepper">
        <IgbStep>
            <span slot="title">Pricing Plan</span>
        </IgbStep>
        <IgbStep>
            <span slot="title">Car Details</span>
        </IgbStep>
        <IgbStep>
            <span slot="title">Payment</span>            
        </IgbStep>          
   </IgbStepper>
</div>

@code {
    public IgbStepper stepper;

    public void onStepTypeChange(IgbRadioChangeEventArgs<string> args)
    {
        if(args.Detail.Checked)
        {
            string value = args.Detail.Value;           
            stepper.StepType = (StepperStepType)System.Enum.Parse(typeof(StepperStepType), value, true); 
        }
    }
}