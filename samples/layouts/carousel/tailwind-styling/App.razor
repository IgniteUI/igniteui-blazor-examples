@using IgniteUI.Blazor.Controls

<div class="container sample center">
    <IgbCarousel class="styled-carousel mx-auto mt-4 h-[430px] w-full max-w-[960px] overflow-hidden rounded-lg border border-[var(--ig-gray-300)] bg-[var(--ig-surface-500)]">
        <span slot="previous-button" class="carousel-navigation-button inline-grid h-5 w-5 place-items-center leading-none"><IgbIcon IconName="chevron-left" Collection="carousel" @ref="iconRef" /></span>
        <span slot="next-button" class="carousel-navigation-button inline-grid h-5 w-5 place-items-center leading-none"><IgbIcon IconName="chevron-right" Collection="carousel" /></span>

        <IgbCarouselSlide>
            <article class="m-0 grid h-full w-full overflow-hidden bg-[var(--ig-gray-100)] md:grid-cols-[1.15fr_0.85fr]">
                <img class="h-52 w-full object-cover md:h-full" src="https://dl.infragistics.com/x/img/carousel/AdobeStock_1937350575-s.png" alt="Scenic travel destination" />
                <section class="grid content-center gap-5 bg-[var(--ig-surface-500)] py-10 pl-8 pr-24 text-[var(--ig-gray-900)]">
                    <div><span class="mb-2 block text-xs font-bold leading-none text-[var(--ig-primary-600)]">01 / ITINERARY</span><h3 class="m-0 text-2xl leading-tight">Scenic getaway</h3><p class="mb-0 mt-2 leading-snug text-[var(--ig-gray-700)]">A flexible travel plan built around memorable views and time to explore.</p></div>
                    <div class="grid grid-cols-3 divide-x divide-[var(--ig-gray-300)] border-y border-[var(--ig-gray-300)] py-3"><span class="px-2 text-center text-xs font-semibold text-[var(--ig-gray-700)] first:pl-0 last:pr-0">3 days</span><span class="px-2 text-center text-xs font-semibold text-[var(--ig-gray-700)] first:pl-0 last:pr-0">8 stops</span><span class="px-2 text-center text-xs font-semibold text-[var(--ig-gray-700)] first:pl-0 last:pr-0">Flexible dates</span></div>
                    <div class="flex flex-wrap gap-2"><span class="rounded-full border border-[var(--ig-gray-300)] px-3 py-1 text-xs text-[var(--ig-gray-700)]">Scenic route</span><span class="rounded-full border border-[var(--ig-gray-300)] px-3 py-1 text-xs text-[var(--ig-gray-700)]">Flexible pace</span></div>
                    <IgbButton>View itinerary</IgbButton>
                </section>
            </article>
        </IgbCarouselSlide>
        <IgbCarouselIndicator><span class="block h-[9px] w-[9px] rounded-full border-2 border-[var(--ig-gray-600)] bg-transparent"></span><span slot="active" class="block h-[9px] w-[9px] rounded-full border-2 border-[var(--ig-primary-500)] bg-[var(--ig-primary-500)]"></span></IgbCarouselIndicator>

        <IgbCarouselSlide>
            <article class="m-0 grid h-full w-full overflow-hidden bg-[var(--ig-gray-100)] md:grid-cols-[1.15fr_0.85fr]">
                <img class="h-52 w-full object-cover md:h-full" src="https://dl.infragistics.com/x/img/carousel/AdobeStock_215535179-s.png" alt="Mountain trail ride" />
                <section class="grid content-center gap-5 bg-[var(--ig-surface-500)] py-10 pl-8 pr-24 text-[var(--ig-gray-900)]">
                    <div><span class="mb-2 block text-xs font-bold leading-none text-[var(--ig-primary-600)]">02 / ITINERARY</span><h3 class="m-0 text-2xl leading-tight">Mountain trail ride</h3><p class="mb-0 mt-2 leading-snug text-[var(--ig-gray-700)]">A high-energy route through rugged terrain, with technical descents and open trail views.</p></div>
                    <div class="grid grid-cols-3 divide-x divide-[var(--ig-gray-300)] border-y border-[var(--ig-gray-300)] py-3"><span class="px-2 text-center text-xs font-semibold text-[var(--ig-gray-700)] first:pl-0 last:pr-0">1 day</span><span class="px-2 text-center text-xs font-semibold text-[var(--ig-gray-700)] first:pl-0 last:pr-0">12 km</span><span class="px-2 text-center text-xs font-semibold text-[var(--ig-gray-700)] first:pl-0 last:pr-0">Advanced</span></div>
                    <div class="flex flex-wrap gap-2"><span class="rounded-full border border-[var(--ig-gray-300)] px-3 py-1 text-xs text-[var(--ig-gray-700)]">Mountain bike</span><span class="rounded-full border border-[var(--ig-gray-300)] px-3 py-1 text-xs text-[var(--ig-gray-700)]">Trail ride</span></div>
                    <IgbButton>View itinerary</IgbButton>
                </section>
            </article>
        </IgbCarouselSlide>
        <IgbCarouselIndicator><span class="block h-[9px] w-[9px] rounded-full border-2 border-[var(--ig-gray-600)] bg-transparent"></span><span slot="active" class="block h-[9px] w-[9px] rounded-full border-2 border-[var(--ig-primary-500)] bg-[var(--ig-primary-500)]"></span></IgbCarouselIndicator>

        <IgbCarouselSlide>
            <article class="m-0 grid h-full w-full overflow-hidden bg-[var(--ig-gray-100)] md:grid-cols-[1.15fr_0.85fr]">
                <img class="h-52 w-full object-cover md:h-full" src="https://dl.infragistics.com/x/img/carousel/AdobeStock_637533323-s.png" alt="Weekend escape" />
                <section class="grid content-center gap-5 bg-[var(--ig-surface-500)] py-10 pl-8 pr-24 text-[var(--ig-gray-900)]">
                    <div><span class="mb-2 block text-xs font-bold leading-none text-[var(--ig-primary-600)]">03 / ITINERARY</span><h3 class="m-0 text-2xl leading-tight">Weekend escape</h3><p class="mb-0 mt-2 leading-snug text-[var(--ig-gray-700)]">A short break with unhurried moments, fresh perspectives, and room to recharge.</p></div>
                    <div class="grid grid-cols-3 divide-x divide-[var(--ig-gray-300)] border-y border-[var(--ig-gray-300)] py-3"><span class="px-2 text-center text-xs font-semibold text-[var(--ig-gray-700)] first:pl-0 last:pr-0">Weekend</span><span class="px-2 text-center text-xs font-semibold text-[var(--ig-gray-700)] first:pl-0 last:pr-0">5 highlights</span><span class="px-2 text-center text-xs font-semibold text-[var(--ig-gray-700)] first:pl-0 last:pr-0">Year round</span></div>
                    <div class="flex flex-wrap gap-2"><span class="rounded-full border border-[var(--ig-gray-300)] px-3 py-1 text-xs text-[var(--ig-gray-700)]">Unwind</span><span class="rounded-full border border-[var(--ig-gray-300)] px-3 py-1 text-xs text-[var(--ig-gray-700)]">Go at your pace</span></div>
                    <IgbButton>View itinerary</IgbButton>
                </section>
            </article>
        </IgbCarouselSlide>
        <IgbCarouselIndicator><span class="block h-[9px] w-[9px] rounded-full border-2 border-[var(--ig-gray-600)] bg-transparent"></span><span slot="active" class="block h-[9px] w-[9px] rounded-full border-2 border-[var(--ig-primary-500)] bg-[var(--ig-primary-500)]"></span></IgbCarouselIndicator>
    </IgbCarousel>
</div>
@code {
    private const string ChevronLeft = """<svg width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>""";
    private const string ChevronRight = """<svg width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M8.59 16.59 10 18l6-6-6-6-1.41 1.41L13.17 12z"/></svg>""";

    private IgbIcon iconRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && iconRef != null)
        {
            await iconRef.EnsureReady();
            await iconRef.RegisterIconFromTextAsync("chevron-left", ChevronLeft, "carousel");
            await iconRef.RegisterIconFromTextAsync("chevron-right", ChevronRight, "carousel");
        }
    }
}