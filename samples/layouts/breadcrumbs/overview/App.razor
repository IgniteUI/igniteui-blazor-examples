@using IgniteUI.Blazor.Controls

<div class="sample">
    <nav aria-label="Breadcrumb">
        <IgbBreadcrumbs>
            <IgbBreadcrumb>
                <IgbIcon @ref="IconRef" slot="prefix" IconName="home" />
                <a href="/home" @onclick:preventDefault>Home</a>
            </IgbBreadcrumb>
            <IgbBreadcrumb>
                <IgbIcon slot="prefix" IconName="notifications" />
                <a href="/home/item" @onclick:preventDefault>Item</a>
            </IgbBreadcrumb>
            <IgbBreadcrumb>
                <IgbIcon slot="prefix" IconName="notifications" />
                <a href="/home/item/item" @onclick:preventDefault>Item</a>
            </IgbBreadcrumb>
            <IgbBreadcrumb>
                <IgbIcon slot="prefix" IconName="notifications" />
                <a href="/home/item/item/item" @onclick:preventDefault>Item</a>
            </IgbBreadcrumb>
            <IgbBreadcrumb Current="true">
                <IgbIcon slot="prefix" IconName="notifications" />
                <a href="/home/item/item/item/current" @onclick:preventDefault>Current Item</a>
            </IgbBreadcrumb>
        </IgbBreadcrumbs>
    </nav>
</div>

@code {
    private const string HomeIcon = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z'/></svg>";
    private const string NotificationsIcon = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z'/></svg>";

    private IgbIcon IconRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await IconRef.EnsureReady();
            await IconRef.RegisterIconFromTextAsync("home", HomeIcon, "default");
            await IconRef.RegisterIconFromTextAsync("notifications", NotificationsIcon, "default");
        }
    }
}
