@using IgniteUI.Blazor.Controls

<div class="sample">
    <IgbIcon @ref="IconRegistrar" IconName="slash" style="display: none;" />
    <nav aria-label="Breadcrumb">
        <IgbBreadcrumbs Separator="slash">
            <IgbBreadcrumb><a href="/home" @onclick:preventDefault>Home</a></IgbBreadcrumb>
            <IgbBreadcrumb><a href="/home/products" @onclick:preventDefault>Products</a></IgbBreadcrumb>
            <IgbBreadcrumb><a href="/home/products/laptops" @onclick:preventDefault>Laptops</a></IgbBreadcrumb>
            <IgbBreadcrumb Current="true"><a href="/home/products/laptops/gaming" @onclick:preventDefault>Gaming Laptop</a></IgbBreadcrumb>
        </IgbBreadcrumbs>
    </nav>
</div>

@code {
    private const string SlashIcon = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none'><path d='M12.8535 3C13.3976 3 13.7655 3.55489 13.5537 4.05604L7.85788 17.5331C7.73829 17.8161 7.46093 18 7.15374 18C6.60638 18 6.23639 17.4416 6.44976 16.9375L12.1535 3.46381C12.2725 3.18266 12.5482 3 12.8535 3Z' fill='currentColor'/></svg>";

    private IgbIcon IconRegistrar;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await IconRegistrar.EnsureReady();
            await IconRegistrar.RegisterIconFromTextAsync("slash", SlashIcon, "default");
        }
    }
}
