@using IgniteUI.Blazor.Controls
@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="container vertical fleet-management-sample ig-typography">
    @* The appearance and size classes sit on the host: both palettes and the density stay inside the
       sample's subtree, and everything rendered in it (the grid's overlays, the dialog and the
       snackbar included) follows them. *@
    <div class="@HostClass">
        <section class="fleet-shell ig-scrollbar" aria-label="Fleet management page">
            <section class="fleet-chip-row" aria-label="Fleet status filters">
                <IgbChip Class="@ChipClass(AllFilter, "fleet-chip")" @onclick="@(() => SetFilter(AllFilter))">All vehicles (@CountOf(AllFilter))</IgbChip>
                <IgbChip Class="@ChipClass(FleetManagementStatus.Active, "fleet-chip fleet-chip-active")" @onclick="@(() => SetFilter(FleetManagementStatus.Active))">Active (@CountOf(FleetManagementStatus.Active))</IgbChip>
                <IgbChip Class="@ChipClass(FleetManagementStatus.Available, "fleet-chip fleet-chip-available")" @onclick="@(() => SetFilter(FleetManagementStatus.Available))">Available (@CountOf(FleetManagementStatus.Available))</IgbChip>
                <IgbChip Class="@ChipClass(FleetManagementStatus.InMaintenance, "fleet-chip fleet-chip-maintenance")" @onclick="@(() => SetFilter(FleetManagementStatus.InMaintenance))">In Maintenance (@CountOf(FleetManagementStatus.InMaintenance))</IgbChip>

                <IgbButton Variant="ButtonVariant.Outlined" Class="fleet-reset" @onclick="AskResetAsync">
                    <IgbIcon slot="prefix" IconName="restart_alt" Collection="@IconCollection" aria-hidden="true"></IgbIcon>
                    <span>Reset</span>
                </IgbButton>

                @* role="group" on the host: igc-button-group keeps its own group role inside its shadow root,
                   where the host's aria-label does not reach. *@
                <IgbButtonGroup Class="fleet-size-group" Selection="ButtonGroupSelection.SingleRequired" role="group" aria-label="Component size" Select="OnSizeSelected">
                    @foreach (var size in Sizes)
                    {
                        <IgbToggleButton Value="@size" Selected="@(Size == size)" title="@SizeTitle(size)"><span>@size</span></IgbToggleButton>
                    }
                </IgbButtonGroup>

                <IgbIconButton Variant="IconButtonVariant.Contained" Class="fleet-theme-toggle" IconName="@(IsDark ? "light_mode" : "dark_mode")" Collection="@IconCollection"
                               title="@ThemeButtonLabel" aria-label="@ThemeButtonLabel" @onclick="ToggleThemeAsync"></IgbIconButton>
            </section>

            @* The status column and the expanded row are JavaScript templates (wwwroot/events.js): the
               grid renders them itself, so expanding a row, scrolling or re-filtering needs no round
               trip to .NET. *@
            <IgbGrid @ref="Grid"
                     Id="@GridId"
                     Class="fleet-master-grid"
                     Data="GridRows"
                     PrimaryKey="Id"
                     AutoGenerate="false"
                     Moving="true"
                     DetailTemplateScript="FleetManagementDetailTemplate"
                     Rendered="OnGridRendered">
                <IgbGridState @ref="GridState"></IgbGridState>

                <IgbGridToolbar>
                    <IgbGridToolbarTitle>
                        <span class="fleet-title-wrap">
                            <span class="fleet-title-icon-wrap">
                                <IgbIcon @ref="TitleIcon" Class="fleet-title-icon" IconName="directions_car" Collection="@IconCollection" aria-hidden="true"></IgbIcon>
                                <IgbIcon Class="fleet-title-icon" IconName="directions_car" Collection="@IconCollection" aria-hidden="true"></IgbIcon>
                                <IgbIcon Class="fleet-title-icon" IconName="directions_car" Collection="@IconCollection" aria-hidden="true"></IgbIcon>
                            </span>
                            <h1>Fleet Management</h1>
                        </span>
                    </IgbGridToolbarTitle>
                    <IgbGridToolbarActions>
                        @* No Value binding: the field is the only writer of the query, and writing the value back
                           would race the user's typing on Blazor Server. Reset empties it by re-creating it. The
                           placeholder is also the field's accessible name: igc-input does not forward aria-label. *@
                        <IgbInput @key="SearchInputKey" Class="fleet-search" DisplayType="InputType.Search" Placeholder="Search fleet" InputOcurred="OnSearchInput">
                            <IgbIcon slot="prefix" IconName="search" Collection="@IconCollection" aria-hidden="true"></IgbIcon>
                        </IgbInput>
                        <IgbGridToolbarHiding></IgbGridToolbarHiding>
                        <IgbGridToolbarPinning></IgbGridToolbarPinning>
                        <IgbGridToolbarAdvancedFiltering></IgbGridToolbarAdvancedFiltering>
                    </IgbGridToolbarActions>
                </IgbGridToolbar>

                <IgbColumn Field="Id" Header="Vehicle ID" DataType="GridColumnDataType.String" Sortable="true" Filterable="false"></IgbColumn>
                <IgbColumn Field="LicensePlate" Header="License Plate" DataType="GridColumnDataType.String" Sortable="true" Filterable="true"></IgbColumn>
                <IgbColumn Field="Make" Header="Make" DataType="GridColumnDataType.String" Sortable="true" Filterable="true"></IgbColumn>
                <IgbColumn Field="Model" Header="Model" DataType="GridColumnDataType.String" Sortable="true" Filterable="true"></IgbColumn>
                <IgbColumn Field="Type" Header="Type" DataType="GridColumnDataType.String" Sortable="true" Filterable="true"></IgbColumn>
                <IgbColumn Field="Vin" Header="VIN" DataType="GridColumnDataType.String" Sortable="true" Filterable="false"></IgbColumn>
                <IgbColumn Field="Status" Header="Status" DataType="GridColumnDataType.String" Sortable="true" Filterable="true"
                           BodyTemplateScript="FleetManagementStatusTemplate"></IgbColumn>
                <IgbColumn Field="LocationCity" Header="Location" DataType="GridColumnDataType.String" Sortable="true" Filterable="true" Width="12%"></IgbColumn>

                @* One action per status the row is not already in, so every status stays reachable from every
                   other one. events.js reads the row off the strip and hides the button of its current status;
                   the colour of each icon is the status it sets, and the label names the action. *@
                <IgbActionStrip>
                    <IgbIconButton Variant="IconButtonVariant.Flat" Class="fleet-row-action fleet-row-action-active" IconName="play_circle" Collection="@IconCollection"
                                   title="Put back in service" aria-label="Put back in service" data-status="Active"></IgbIconButton>
                    <IgbIconButton Variant="IconButtonVariant.Flat" Class="fleet-row-action fleet-row-action-available" IconName="check_circle" Collection="@IconCollection"
                                   title="Mark available" aria-label="Mark available" data-status="Available"></IgbIconButton>
                    <IgbIconButton Variant="IconButtonVariant.Flat" Class="fleet-row-action fleet-row-action-maintenance" IconName="build" Collection="@IconCollection"
                                   title="Send to maintenance" aria-label="Send to maintenance" data-status="In Maintenance"></IgbIconButton>
                </IgbActionStrip>
            </IgbGrid>

            <IgbSnackbar @ref="Snackbar" Class="fleet-snackbar" DisplayTime="3000" KeepOpen="false">@NoticeMessage</IgbSnackbar>
        </section>

        <IgbDialog @ref="ResetDialog" Class="fleet-reset-dialog" Title="Reset the fleet?" CloseOnOutsideClick="true">
            <p class="fleet-reset-message">Vehicle statuses, the status filter, the search, the component size and the theme all go back to how they opened, along with the grid's sorting, filters, column order, pinning and expanded rows.</p>
            <IgbButton slot="footer" Variant="ButtonVariant.Flat" @onclick="CancelResetAsync">Cancel</IgbButton>
            <IgbButton slot="footer" Variant="ButtonVariant.Contained" @onclick="ConfirmResetAsync">Reset</IgbButton>
        </IgbDialog>
    </div>
</div>

@code {
    private const string GridId = "fleetManagementGrid";

    // A collection of the sample's own: other samples in the samples browser register different
    // icons under "material".
    private const string IconCollection = "fleet-management";

    private const string AllFilter = "all";
    private const string DefaultSize = "medium";
    private const bool DefaultIsDark = true;
    private static readonly string[] Sizes = { "small", "medium", "large" };

    // Material Icons (Apache-2.0), 24px viewBox. igc-icon renders registered SVGs, not ligatures.
    private const string DirectionsCarIcon = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z'/></svg>";
    private const string RestartAltIcon = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 5V2L8 6l4 4V7c3.31 0 6 2.69 6 6 0 2.97-2.17 5.43-5 5.91v2.02c3.95-.49 7-3.85 7-7.93 0-4.42-3.58-8-8-8zm-6 8c0-1.65.67-3.15 1.76-4.24L6.34 7.34C4.9 8.79 4 10.79 4 13c0 4.08 3.05 7.44 7 7.93v-2.02c-2.83-.48-5-2.94-5-5.91z'/></svg>";
    private const string LightModeIcon = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58c-.39-.39-1.03-.39-1.41 0-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37c-.39-.39-1.03-.39-1.41 0-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0 .39-.39.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96c.39-.39.39-1.03 0-1.41-.39-.39-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36c.39-.39.39-1.03 0-1.41-.39-.39-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z'/></svg>";
    private const string DarkModeIcon = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z'/></svg>";
    private const string SearchIcon = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z'/></svg>";
    private const string PlayCircleIcon = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM9.5 16.5v-9l7 4.5-7 4.5z'/></svg>";
    private const string CheckCircleIcon = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z'/></svg>";
    private const string BuildIcon = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z'/></svg>";

    private IgbGrid Grid;
    private IgbGridState GridState;
    private IgbIcon TitleIcon;
    private IgbSnackbar Snackbar;
    private IgbDialog ResetDialog;

    private List<FleetManagementVehicle> Vehicles;
    private List<FleetManagementRecord> GridRows;

    // The expanded row's JSON per vehicle, status and photo availability: status is the only input
    // that changes, so an entry is built once and replaced when the vehicle changes.
    private readonly Dictionary<string, string> DetailCache = new Dictionary<string, string>();

    // Vehicles whose every photo failed to load; their expanded row shows the placeholder.
    private readonly HashSet<string> VehiclesWithoutPhoto = new HashSet<string>();

    private string StatusFilter = AllFilter;
    private string SearchQuery = "";
    private int SearchInputKey;
    private string Size = DefaultSize;
    private bool IsDark = DefaultIsDark;
    private string NoticeMessage = "";

    // The untouched grid layout (sorting, filters, column order, pinning, hiding, expanded rows),
    // taken before the user can touch anything, for Reset (OnGridRendered).
    private const int GridColumnCount = 8;
    private string PristineGridState;
    private bool IsTakingSnapshot;
    private bool IsDisposed;

    private bool HasNewGridRows;
    private bool HasNewSearch;
    private bool HasNewSize;
    private bool HasPendingNotice;

    // What events.js calls back (row actions, failed photos), from fleetManagementConnect to
    // fleetManagementDisconnect. Null while events.js is not connected.
    private IDisposable ScriptReference;

    private string HostClass
    {
        get
        {
            var names = "fleet-management-host";
            if (!IsDark)
            {
                names += " light-theme";
            }

            if (Size != DefaultSize)
            {
                names += " fleet-size-" + Size;
            }

            return names;
        }
    }

    private string ThemeButtonLabel => IsDark ? "Switch to light mode" : "Switch to dark mode";

    private static string SizeTitle(string size) => "Render the sample at " + size + " size";

    private string ChipClass(string filter, string names) => StatusFilter == filter ? names + " active" : names;

    protected override void OnInitialized()
    {
        Vehicles = FleetManagementFleet.CreateVehicles();
        GridRows = CreateGridRows();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (HasNewGridRows)
        {
            // IgbGrid passes a new Data list to the grid with its next update; any grid method call
            // sends it first, so the search marks that follow see the new rows.
            HasNewGridRows = false;
            await Grid.GetDefaultRowHeightAsync();
        }

        if (HasNewSize)
        {
            // Row height derives from --ig-size and virtualization caches it, so the grid measures
            // again once the new density class is on the page. EnsureReady: the size can change
            // before the grid takes method calls.
            HasNewSize = false;
            await Grid.EnsureReady();
            await Grid.ReflowAsync();
        }

        if (HasNewSearch)
        {
            // The query filters the rows; the grid's own search marks where each row matched.
            HasNewSearch = false;
            await Grid.ClearSearchAsync();
            var query = SearchQuery.Trim();
            if (query.Length > 0)
            {
                await Grid.FindNextAsync(query, false, false);
            }
        }

        if (HasPendingNotice)
        {
            HasPendingNotice = false;
            await Snackbar.ShowAsync();
        }

        if (!firstRender)
        {
            return;
        }

        // events.js is connected before anything else is awaited: on Blazor Server every await below is
        // a round trip, and a component disposed during them would otherwise connect afterwards to a
        // grid that has already left the page.
        var selfReference = DotNetObjectReference.Create(this);
        ScriptReference = selfReference;
        try
        {
            await JS.InvokeVoidAsync("fleetManagementConnect", GridId, selfReference, IsDark);
        }
        catch (JSException)
        {
            // events.js is not on the page: the grid shows plain values and no expanded rows.
            ScriptReference = null;
            selfReference.Dispose();
        }

        await TitleIcon.EnsureReady();
        await TitleIcon.RegisterIconFromTextAsync("directions_car", DirectionsCarIcon, IconCollection);
        await TitleIcon.RegisterIconFromTextAsync("restart_alt", RestartAltIcon, IconCollection);
        await TitleIcon.RegisterIconFromTextAsync("light_mode", LightModeIcon, IconCollection);
        await TitleIcon.RegisterIconFromTextAsync("dark_mode", DarkModeIcon, IconCollection);
        await TitleIcon.RegisterIconFromTextAsync("search", SearchIcon, IconCollection);
        await TitleIcon.RegisterIconFromTextAsync("play_circle", PlayCircleIcon, IconCollection);
        await TitleIcon.RegisterIconFromTextAsync("check_circle", CheckCircleIcon, IconCollection);
        await TitleIcon.RegisterIconFromTextAsync("build", BuildIcon, IconCollection);
    }

    // The layout snapshot Reset restores, taken before the user can touch anything. The grid reports
    // Rendered (and its state directive answers) before IgbGrid has added the columns, and a snapshot
    // without them would remove every column on Reset; they follow within a few frames, so the
    // snapshot is retaken until it holds all of them.
    private async Task OnGridRendered()
    {
        if (PristineGridState != null || IsTakingSnapshot)
        {
            return;
        }

        IsTakingSnapshot = true;
        for (var attempt = 0; attempt < 50 && !IsDisposed; attempt++)
        {
            var state = await GridState.GetStateAsStringAsync(new string[0]);
            if (ColumnCountOf(state) >= GridColumnCount)
            {
                PristineGridState = state;
                break;
            }

            await Task.Delay(100);
        }

        IsTakingSnapshot = false;
    }

    private static int ColumnCountOf(string state)
    {
        try
        {
            using var document = JsonDocument.Parse(state ?? "{}");
            return document.RootElement.TryGetProperty("columns", out var columns) && columns.ValueKind == JsonValueKind.Array ? columns.GetArrayLength() : 0;
        }
        catch (JsonException)
        {
            return 0;
        }
    }

    // Row action (events.js): the strip's button for the given status on the given row.
    [JSInvokable]
    public Task FleetManagementSetStatus(string id, string status)
    {
        var vehicle = Vehicles.FirstOrDefault(item => item.Id == id);
        if (vehicle == null || vehicle.Status == status || !FleetManagementStatus.All.Contains(status))
        {
            return Task.CompletedTask;
        }

        vehicle.Status = status;
        ShowNewRows();
        Notify(vehicle.Id + " \u2014 " + vehicle.Make + " " + vehicle.Model + " set to " + status);
        return InvokeAsync(StateHasChanged);
    }

    // Every photo of the vehicle failed to load (events.js): its expanded row shows the placeholder.
    [JSInvokable]
    public Task FleetManagementPhotoUnavailable(string id)
    {
        if (!VehiclesWithoutPhoto.Add(id))
        {
            return Task.CompletedTask;
        }

        ShowNewRows();
        return InvokeAsync(StateHasChanged);
    }

    private void SetFilter(string filter)
    {
        if (StatusFilter == filter)
        {
            return;
        }

        StatusFilter = filter;
        ShowNewRows();
    }

    private void OnSearchInput(IgbComponentValueChangedEventArgs e)
    {
        var text = e.Detail ?? "";
        var queryChanged = Normalize(text) != Normalize(SearchQuery);
        SearchQuery = text;

        // Text that compares the same (a trailing space, another letter case) keeps the rows and the
        // marks: the grid's search is not case-sensitive either.
        if (queryChanged)
        {
            ShowNewRows();
            HasNewSearch = true;
        }
    }

    private void OnSizeSelected(IgbComponentValueChangedEventArgs e)
    {
        var size = e.Detail;
        if (Array.IndexOf(Sizes, size) >= 0 && size != Size)
        {
            Size = size;
            HasNewSize = true;
        }
    }

    private async Task ToggleThemeAsync()
    {
        IsDark = !IsDark;
        await SendThemeAsync();
    }

    // The charts paint with resolved colours, so events.js takes the appearance and has the grid run
    // its templates again; the host's class reaches the page only after this call. Until events.js is
    // connected, fleetManagementConnect hands it the appearance instead.
    private async Task SendThemeAsync()
    {
        if (ScriptReference != null)
        {
            await JS.InvokeVoidAsync("fleetManagementSetTheme", GridId, IsDark);
        }
    }

    // Reset throws away everything the user has done, so it asks first; ConfirmResetAsync resets.
    private async Task AskResetAsync()
    {
        await ResetDialog.ShowAsync();
    }

    private async Task CancelResetAsync()
    {
        await ResetDialog.HideAsync();
    }

    private async Task ConfirmResetAsync()
    {
        await ResetDialog.HideAsync();

        // The grid's layout goes back first (sorting, filters, column order, pinning, hiding and
        // expanded rows), while the grid still shows the rows it has. Restored after the new rows
        // instead, it would build the detail of a row that was expanded in the old list and drop it
        // again at once, and igc-tabs throws when it leaves the page before its first frame. Cell
        // ranges are the one piece the state restores on top of rather than replacing, so they are
        // cleared first.
        if (PristineGridState != null)
        {
            await Grid.ClearCellSelectionAsync();
            await GridState.ApplyStateFromStringAsync(PristineGridState, new string[0]);
        }

        if (IsDark != DefaultIsDark)
        {
            IsDark = DefaultIsDark;
            await SendThemeAsync();
        }

        Vehicles = FleetManagementFleet.CreateVehicles();
        StatusFilter = AllFilter;
        SearchQuery = "";
        SearchInputKey++;
        if (Size != DefaultSize)
        {
            Size = DefaultSize;
            HasNewSize = true;
        }

        ShowNewRows();
        HasNewSearch = true;
        Notify("Fleet reset to its opening state");
    }

    private void Notify(string message)
    {
        NoticeMessage = message;
        HasPendingNotice = true;
    }

    private void ShowNewRows()
    {
        GridRows = CreateGridRows();
        HasNewGridRows = true;
    }

    private static string Normalize(string text) => (text ?? "").Trim().ToLowerInvariant();

    // Everything the search matches, before the status chips narrow it further. The fields are
    // matched as one line, so "ford focus" finds the Focus.
    private IEnumerable<FleetManagementVehicle> SearchedVehicles()
    {
        var query = Normalize(SearchQuery);
        if (query.Length == 0)
        {
            return Vehicles;
        }

        return Vehicles.Where(vehicle => string.Join(" ", vehicle.Id, vehicle.LicensePlate, vehicle.Vin, vehicle.Make, vehicle.Model, vehicle.LocationCity)
            .ToLowerInvariant()
            .Contains(query));
    }

    // Counted off the search results, so the chips and the rows always agree.
    private int CountOf(string filter)
    {
        var vehicles = SearchedVehicles();
        return filter == AllFilter ? vehicles.Count() : vehicles.Count(vehicle => vehicle.Status == filter);
    }

    private List<FleetManagementRecord> CreateGridRows()
    {
        var vehicles = SearchedVehicles();
        if (StatusFilter != AllFilter)
        {
            vehicles = vehicles.Where(vehicle => vehicle.Status == StatusFilter);
        }

        return vehicles.Select(ToRecord).ToList();
    }

    private FleetManagementRecord ToRecord(FleetManagementVehicle vehicle)
    {
        var hasPhoto = !VehiclesWithoutPhoto.Contains(vehicle.Id);
        var key = vehicle.Id + ":" + vehicle.Status + ":" + hasPhoto;
        if (!DetailCache.TryGetValue(key, out var detail))
        {
            detail = FleetManagementDetails.ToJson(FleetManagementDetails.Build(vehicle, hasPhoto, DateTime.Now.Year));
            DetailCache[key] = detail;
        }

        return new FleetManagementRecord
        {
            Id = vehicle.Id,
            LicensePlate = vehicle.LicensePlate,
            Make = vehicle.Make,
            Model = vehicle.Model,
            Type = vehicle.Type,
            Vin = vehicle.Vin,
            Status = vehicle.Status,
            LocationCity = vehicle.LocationCity,
            StatusVariant = StatusVariant(vehicle.Status),
            StatusPulse = vehicle.Status == FleetManagementStatus.InMaintenance,
            Detail = detail
        };
    }

    // The badge colour per status; only the state that needs acting on pulses.
    private static string StatusVariant(string status)
    {
        switch (status)
        {
            case FleetManagementStatus.Available:
                return "success";
            case FleetManagementStatus.InMaintenance:
                return "warning";
            default:
                return "info";
        }
    }

    public async ValueTask DisposeAsync()
    {
        IsDisposed = true;
        if (ScriptReference == null)
        {
            return;
        }

        try
        {
            // events.js holds on to the grid it connected, so it destroys the charts of the expanded
            // rows whether or not the render that removes the grid has reached the page yet.
            await JS.InvokeVoidAsync("fleetManagementDisconnect");
        }
        catch (JSDisconnectedException)
        {
        }

        ScriptReference.Dispose();
    }
}
