@using IgniteUI.Blazor.Controls
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="container vertical sales-dashboard-sample ig-typography ig-scrollbar">
    @* The dashboard itself: one CSS grid, four tracks wide, and the container its breakpoints
       query (index.css, "Layout"). The theme class sits here, so both palettes stay inside the
       sample's subtree. *@
    <div class="@DashboardClass" @ref="Dashboard">
        <header class="title-row">
            <h1>Sales Overview</h1>
            <div class="status-row">
                <IgbBadge Class="success-badge" Variant="StyleVariant.Success" Shape="BadgeShape.Square" Dot="true" aria-label="Live status"></IgbBadge>
                <span>LIVE &middot; UPDATED JUST NOW</span>
                <IgbIconButton Class="theme-toggle" Variant="IconButtonVariant.Flat" IconName="@(IsDark ? "light_mode" : "dark_mode")" Collection="@IconCollection"
                               title="@ThemeButtonLabel" aria-label="@ThemeButtonLabel" @onclick="ToggleThemeAsync"></IgbIconButton>
            </div>
        </header>

        <section class="metrics-grid" aria-label="KPI metrics">
            @foreach (var item in Metrics)
            {
                @* role and aria-label restate what the Angular sample's igx-card and igx-badge
                   expose (a group; a status named "badge"); igc-card and igc-badge do not. *@
                <IgbCard Class="metric-tile" role="group">
                    <IgbCardContent Class="metric-body">
                        <div class="metric-head">
                            <span class="metric-label">@item.Label</span>
                            <IgbAvatar Class="@MetricIconClass(item)">
                                <IgbIcon @ref="RegistrationIcon" IconName="@item.Icon" Collection="@IconCollection" aria-hidden="true"></IgbIcon>
                            </IgbAvatar>
                        </div>
                        <div class="metric-value">@item.Value</div>
                        @* The arrow repeats the tint's meaning for anyone who cannot tell the two
                           colours apart. *@
                        <IgbBadge Class="@MetricDeltaClass(item)" Variant="@(item.IsPositive ? StyleVariant.Success : StyleVariant.Danger)" aria-label="badge">
                            <IgbIcon IconName="@(item.IsPositive ? "arrow_upward" : "arrow_downward")" Collection="@IconCollection" aria-hidden="true"></IgbIcon>
                            <span>@item.Delta</span>
                        </IgbBadge>
                    </IgbCardContent>
                </IgbCard>
            }
        </section>

        <section class="upper-panels">
            <article class="panel trend-panel">
                <header class="panel-title split">
                    <span>Revenue Trend</span>
                    <div class="trend-legend" aria-label="Revenue trend legend">
                        <span class="trend-legend-item">
                            <span class="trend-legend-swatch" style="background: @Palette.Trend[0]"></span>
                            <span>Revenue</span>
                        </span>
                        <span class="trend-legend-item">
                            <span class="trend-legend-swatch" style="background: @Palette.Trend[1]"></span>
                            <span>Target</span>
                        </span>
                    </div>
                </header>
                <div class="panel-body">
                    @* The charts render once events.js is connected (ChartsReady): the rectangle
                       the chart engine paints behind an item tooltip is read when a chart is
                       created, and salesDashboardConnect sets it first. Each chart is keyed by the
                       palette, so a theme toggle creates it again, as the Angular sample does: a
                       ring series keeps drawing its slice labels in the colour it was created
                       with. *@
                    <div class="chart-box">
                        @if (ChartsReady)
                        {
                            <IgbCategoryChart @key="Palette" Width="100%" Height="100%" DataSource="RevenueTrend" ChartType="CategoryChartType.Line"
                                              IncludedProperties="@TrendProperties"
                                              XAxisLabelTextStyle="@AxisLabelTextStyle" YAxisLabelTextStyle="@AxisLabelTextStyle"
                                              XAxisLabelTextColor="@Palette.Label" YAxisLabelTextColor="@Palette.Label"
                                              XAxisMajorStroke="@Palette.Gridline" YAxisMajorStroke="@Palette.Gridline"
                                              CrosshairsAnnotationXAxisBackground="@Palette.Bubble" CrosshairsAnnotationXAxisTextColor="@Palette.BubbleText"
                                              CrosshairsAnnotationYAxisBackground="@Palette.Bubble" CrosshairsAnnotationYAxisTextColor="@Palette.BubbleText"
                                              Brushes="@Palette.TrendBrushes" Outlines="@Palette.TrendBrushes"
                                              MarkerBrushes="@Palette.TrendBrushes" MarkerOutlines="@Palette.TrendBrushes"
                                              ToolTipType="ToolTipType.Item" SeriesAddedScript="SalesDashboardTrendSeriesAdded"
                                              IsItemHighlightingEnabled="false" IsHorizontalZoomEnabled="false" IsVerticalZoomEnabled="false"
                                              Thickness="2" YAxisInterval="25" YAxisMinimumValue="620" YAxisMaximumValue="810"></IgbCategoryChart>
                        }
                    </div>
                </div>
            </article>

            <article class="panel region-panel">
                <header class="panel-title">Revenue by Region</header>
                <div class="panel-body">
                    <p class="subtle">$842K total</p>
                    <div class="donut-box">
                        @if (ChartsReady)
                        {
                            <IgbDoughnutChart @key="Palette" Width="100%" Height="190px" AllowSliceSelection="true" AllowSliceExplosion="true" InnerExtent="55">
                                <IgbRingSeries DataSource="RevenueByRegion" ValueMemberPath="Value" LabelMemberPath="Region"
                                               LabelsPosition="LabelsPosition.OutsideEnd"
                                               Brushes="@Palette.SeriesBrushes" Outlines="@Palette.SeriesBrushes"
                                               LabelOuterColor="@Palette.SliceLabel" LabelInnerColor="@Palette.SliceLabel"></IgbRingSeries>
                            </IgbDoughnutChart>
                        }
                    </div>

                    <ul class="legend-list" aria-label="Revenue by region legend">
                        @for (var index = 0; index < RevenueByRegion.Count; index++)
                        {
                            var region = RevenueByRegion[index];
                            <li>
                                <span class="legend-name-wrap">
                                    <span class="legend-swatch" style="background: @Palette.Series[index]"></span>
                                    <span class="legend-name">@region.Region</span>
                                </span>
                                <span class="legend-value">@(region.Value)%</span>
                            </li>
                        }
                    </ul>
                </div>
            </article>

            <article class="panel deals-panel">
                <header class="panel-title split">
                    <span>Deals Closed This Week</span>
                    <span class="subtle">37 total</span>
                </header>
                <div class="panel-body">
                    <div class="deals-chart">
                        @if (ChartsReady)
                        {
                            <IgbCategoryChart @key="Palette" Width="100%" Height="100%" DataSource="WeeklyDeals" ChartType="CategoryChartType.Column"
                                              XAxisLabelTextStyle="@AxisLabelTextStyle" YAxisLabelTextStyle="@AxisLabelTextStyle"
                                              XAxisLabelTextColor="@Palette.Label" YAxisLabelTextColor="@Palette.Label"
                                              XAxisMajorStroke="@Palette.Gridline" YAxisMajorStroke="@Palette.Gridline"
                                              CrosshairsAnnotationXAxisBackground="@Palette.Bubble" CrosshairsAnnotationXAxisTextColor="@Palette.BubbleText"
                                              CrosshairsAnnotationYAxisBackground="@Palette.Bubble" CrosshairsAnnotationYAxisTextColor="@Palette.BubbleText"
                                              Brushes="@Palette.DealsBrushes" Outlines="@Palette.DealsBrushes"
                                              ToolTipType="ToolTipType.Item" SeriesAddedScript="SalesDashboardDealsSeriesAdded"
                                              IsHorizontalZoomEnabled="false" IsVerticalZoomEnabled="false"
                                              Thickness="1" YAxisInterval="10" YAxisMinimumValue="0" YAxisMaximumValue="50"></IgbCategoryChart>
                        }
                    </div>
                </div>
            </article>
        </section>

        <section class="lower-panels">
            <section class="panel activity-panel">
                <header class="panel-title split">
                    <span>Recent Activity</span>
                </header>
                <div class="panel-body">
                    @* Five static rows. The Stage pill is a JavaScript cell template
                       (BodyTemplateScript, events.js), so no cell needs a round trip to .NET on
                       either host; its class comes from C# (SalesDashboardStages.ClassFor). *@
                    <IgbGrid Class="activity-grid" Data="ActivityRows" AutoGenerate="false" Width="100%" Height="100%">
                        <IgbColumn Field="Company" Header="COMPANY" Sortable="false" Filterable="false"></IgbColumn>
                        <IgbColumn Field="Region" Header="REGION" Sortable="false" Filterable="false"></IgbColumn>
                        <IgbColumn Field="Stage" Header="STAGE" Sortable="false" Filterable="false" BodyTemplateScript="SalesDashboardStageTemplate"></IgbColumn>
                        <IgbColumn Field="Value" Header="VALUE" Sortable="false" Filterable="false"></IgbColumn>
                        <IgbColumn Field="Rep" Header="REP" Sortable="false" Filterable="false"></IgbColumn>
                        <IgbColumn Field="Source" Header="SOURCE" Sortable="false" Filterable="false"></IgbColumn>
                        <IgbColumn Field="When" Header="WHEN" Sortable="false" Filterable="false"></IgbColumn>
                    </IgbGrid>
                </div>
            </section>

            <article class="panel leaderboard-panel">
                <header class="panel-title">Leaderboard</header>
                <div class="panel-body">
                    <IgbList>
                        @foreach (var person in Leaderboard)
                        {
                            <IgbListItem>
                                <div class="leader-row">
                                    <div class="leader-left">
                                        <IgbAvatar Class="@person.BadgeClass" Initials="@person.Rank.ToString()"></IgbAvatar>
                                        <div>
                                            <div class="leader-name">@person.Name</div>
                                            <small>@person.Quota</small>
                                        </div>
                                    </div>
                                    <div class="leader-right">
                                        <div class="leader-amount">@person.Amount</div>
                                        <small class="@(person.IsPositive ? "" : "negative")">@person.Delta</small>
                                    </div>
                                </div>
                            </IgbListItem>
                        }
                    </IgbList>
                </div>
            </article>
        </section>
    </div>
</div>

@code {
