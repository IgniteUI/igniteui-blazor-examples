 4.266 18 4.594L16.969 5.625Q16.641 5.953 16.641 6.352Q16.641 6.75 16.969 7.031Q17.25 7.313 17.672 7.336Q18.094 7.359 18.375 7.031ZM6 19.406L7.031 18.375Q7.359 18.047 7.359 17.648Q7.359 17.25 7.031 16.969Q6.75 16.641 6.328 16.641Q5.906 16.641 5.625 16.969L4.594 18Q4.266 18.281 4.266 18.703Q4.266 19.125 4.594 19.406Q4.875 19.688 5.297 19.711Q5.719 19.734 6 19.406Z'/></svg>";
    private const string DarkModeIcon = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 3Q10.125 3 8.508 3.703Q6.891 4.406 5.648 5.648Q4.406 6.891 3.703 8.508Q3 10.125 3 12Q3 13.875 3.703 15.492Q4.406 17.109 5.648 18.352Q6.891 19.594 8.508 20.297Q10.125 21 12 21Q13.875 21 15.492 20.297Q17.109 19.594 18.352 18.352Q19.594 17.109 20.297 15.492Q21 13.875 21 12Q21 11.672 20.977 11.32Q20.953 10.969 20.906 10.641Q20.156 11.672 19.008 12.281Q17.859 12.891 16.5 12.891Q15 12.891 13.781 12.164Q12.563 11.438 11.836 10.219Q11.109 9 11.109 7.5Q11.109 6.141 11.719 4.992Q12.328 3.844 13.359 3.094Q13.031 3.047 12.68 3.023Q12.328 3 12 3Z'/></svg>";

    // Month labels the categories; Revenue and TargetLine are the two lines.
    private static readonly string[] TrendProperties = new string[] { "Month", "Revenue", "TargetLine" };

    private readonly List<SalesDashboardMetric> Metrics = SalesDashboardData.CreateMetrics();
    private readonly List<SalesDashboardTrendPoint> RevenueTrend = SalesDashboardData.CreateRevenueTrend();
    private readonly List<SalesDashboardRegionShare> RevenueByRegion = SalesDashboardData.CreateRevenueByRegion();
    private readonly List<SalesDashboardDealDay> WeeklyDeals = SalesDashboardData.CreateWeeklyDeals();
    private readonly List<SalesDashboardLeader> Leaderboard = SalesDashboardData.CreateLeaderboard();
    private readonly List<SalesDashboardActivityRow> ActivityRows = SalesDashboardData.CreateActivityRows();

    // Any one of the icons: the registrations go to a registry every igc-icon on the page reads.
    private IgbIcon RegistrationIcon;

    // The dashboard element, for events.js (salesDashboardConnect).
    private ElementReference Dashboard;

    private bool IsDark;
    private bool ChartsReady;

    // True from the salesDashboardConnect call to salesDashboardDisconnect: set before the call is
    // awaited, so a disposal during that await still disconnects.
    private bool IsConnected;
    private bool IsDisposed;

    private SalesDashboardChartPalette Palette => IsDark ? SalesDashboardChartPalette.Dark : SalesDashboardChartPalette.Light;
    private string DashboardClass => IsDark ? "sales-dashboard dark-theme" : "sales-dashboard";
    private string ThemeButtonLabel => IsDark ? "Switch to light mode" : "Switch to dark mode";

    private static string MetricIconClass(SalesDashboardMetric item) => "metric-icon " + item.IconClass;
    private static string MetricDeltaClass(SalesDashboardMetric item) => item.IsPositive ? "metric-delta" : "metric-delta negative";

    protected override void OnInitialized()
    {
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // events.js is connected before anything else is awaited: on Blazor Server every await is
        // a round trip, and a component disposed in between would otherwise connect afterwards.
        IsConnected = true;
        try
        {
            await JS.InvokeVoidAsync("salesDashboardConnect", Dashboard, IsDark);
        }
        catch (JSException)
        {
            // events.js is not on the page: the charts keep the engine's default tooltips.
            IsConnected = false;
        }

        if (IsDisposed)
        {
            return;
        }

        // The charts are created now, after the tooltip styling above is in place.
        ChartsReady = true;
        StateHasChanged();

        await RegistrationIcon.EnsureReady();
        await RegistrationIcon.RegisterIconFromTextAsync("attach_money", AttachMoneyIcon, IconCollection);
        await RegistrationIcon.RegisterIconFromTextAsync("percent", PercentIcon, IconCollection);
        await RegistrationIcon.RegisterIconFromTextAsync("tag", TagIcon, IconCollection);
        await RegistrationIcon.RegisterIconFromTextAsync("diamond", DiamondIcon, IconCollection);
        await RegistrationIcon.RegisterIconFromTextAsync("arrow_upward", ArrowUpwardIcon, IconCollection);
        await RegistrationIcon.RegisterIconFromTextAsync("arrow_downward", ArrowDownwardIcon, IconCollection);
        await RegistrationIcon.RegisterIconFromTextAsync("light_mode", LightModeIcon, IconCollection);
        await RegistrationIcon.RegisterIconFromTextAsync("dark_mode", DarkModeIcon, IconCollection);
    }

    private async Task ToggleThemeAsync()
    {
        IsDark = !IsDark;

        // The palette follows the dashboard's class and the charts follow Palette, both through
        // this component's own render. The chart tooltips are rendered by events.js outside the
        // sample's subtree, so they take the appearance from this call; until events.js is
        // connected, salesDashboardConnect hands it over instead.
        if (IsConnected)
        {
            await JS.InvokeVoidAsync("salesDashboardSetTheme", IsDark);
        }
    }

    public async ValueTask DisposeAsync()
    {
        IsDisposed = true;
        if (!IsConnected)
        {
            return;
        }

        IsConnected = false;
        try
        {
            await JS.InvokeVoidAsync("salesDashboardDisconnect");
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
