@using IgniteUI.Blazor.Controls

<div class="container sample flex items-center justify-center">
    <div class="flex items-start gap-[3.75rem] [--ig-font-family:aktiv-grotesk,sans-serif]">
        <IgbDialog class="[--ig-dialog-background:var(--color-export-surface)] [--ig-dialog-border-color:transparent] [--ig-dialog-border-radius:1rem] [--ig-dialog-elevation:none] [--ig-dialog-message-color:var(--color-export-muted)] [--ig-dialog-title-color:var(--color-export-ink)] [&::part(base)]:static [&::part(base)]:m-0 [&::part(base)]:block [&::part(base)]:w-[17.5rem] [&::part(base)]:min-w-0 [&::part(base)]:border-0 [&::part(content)]:px-6 [&::part(content)]:py-3.5 [&::part(content)]:text-xs/4 [&::part(content)]:font-semibold [&::part(content)]:tracking-[0.15px] [&::part(footer)]:pt-0 [&::part(footer)]:pr-6 [&::part(footer)]:pb-6 [&::part(footer)]:pl-2 [&::part(footer)]:border-0 [&::part(title)]:px-6 [&::part(title)]:pt-4 [&::part(title)]:pb-0 [&::part(title)]:border-0 [&::part(title)]:text-base/5 [&::part(title)]:font-bold [&::part(title)]:tracking-normal">
            <span slot="title">Export complete</span>
            <span slot="message">
                analytics_report_Q3.csv
                <br />
                has been exported to your Downloads folder.
            </span>
            <IgbButton slot="footer"
                       Variant="ButtonVariant.Contained"
                       class="[&::part(base)]:h-[1.875rem] [&::part(base)]:w-[4.0625rem] [&::part(base)]:min-w-0 [&::part(base)]:rounded-lg [&::part(base)]:bg-[var(--color-export-accent)] [&::part(base)]:px-2 [&::part(base)]:text-xs/4 [&::part(base)]:font-semibold [&::part(base)]:tracking-[0.15px] [&::part(base)]:text-black [&::part(base)]:normal-case [&::part(base)]:shadow-[shadow:var(--ig-elevation-2)] [&::part(base)]:hover:bg-[var(--color-export-accent-hover)]">
                Got it
            </IgbButton>
        </IgbDialog>
        <IgbDialog HideDefaultAction="true"
                   class="[--ig-dialog-background:var(--color-invite-surface)] [--ig-dialog-border-color:var(--color-invite-border)] [--ig-dialog-border-radius:0.5rem] [--ig-dialog-elevation:none] [--ig-dialog-message-color:var(--color-invite-ink)] [--ig-dialog-title-color:var(--color-invite-ink)] [&::part(base)]:static [&::part(base)]:m-0 [&::part(base)]:block [&::part(base)]:w-[15.5625rem] [&::part(base)]:min-w-0 [&::part(content)]:px-6 [&::part(content)]:py-3.5 [&::part(content)]:text-xs/4 [&::part(content)]:font-semibold [&::part(content)]:tracking-[0.15px] [&::part(title)]:justify-between [&::part(title)]:px-6 [&::part(title)]:pt-4 [&::part(title)]:pb-0 [&::part(title)]:border-0 [&::part(title)]:text-base/5 [&::part(title)]:font-bold [&::part(title)]:tracking-normal">
            <span slot="title">Invitation sent</span>
            <IgbIconButton @ref="ClearButtonRef"
                           slot="title"
                           Variant="IconButtonVariant.Outlined"
                           IconName="clear"
                           Collection="material"
                           aria-label="Close"
                           class="[&::part(base)]:size-6 [&::part(base)]:p-0 [&::part(base)]:rounded-full [&::part(base)]:border [&::part(base)]:border-[var(--color-invite-ink)] [--ig-outlined-icon-button-foreground:var(--color-invite-ink)]" />
            <span slot="message">
                <span class="text-[var(--color-invite-link)]">john.smith@company.com</span> has been invited to your team.
            </span>
        </IgbDialog>
    </div>
</div>

@code {
    private const string ClearIcon = "<svg xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 18 18'><path fill-rule='evenodd' clip-rule='evenodd' d='M14.25 4.8075L13.1925 3.75L9 7.9425L4.8075 3.75L3.75 4.8075L7.9425 9L3.75 13.1925L4.8075 14.25L9 10.0575L13.1925 14.25L14.25 13.1925L10.0575 9L14.25 4.8075Z'/></svg>";

    private IgbIconButton ClearButtonRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && ClearButtonRef != null)
        {
            ClearButtonRef.EnsureReady().ContinueWith(_ =>
            {
                ClearButtonRef.RegisterIconFromText("clear", ClearIcon, "material");
            });
        }
    }
}
