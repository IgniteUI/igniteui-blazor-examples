@using IgniteUI.Blazor.Controls

<div class="container sample">
    <IgbButton class="open-button" Variant="ButtonVariant.Outlined" @onclick="ShowDialog">Open dialog</IgbButton>
    <IgbDialog Title="Confirmation" Open="IsOpen" Closed="@(args => IsOpen = false)">
        <span slot="message">Your email will be permanently deleted</span>
        <IgbButton slot="footer" Variant="ButtonVariant.Flat" @onclick="HideDialog">Cancel</IgbButton>
        <IgbButton slot="footer" Variant="ButtonVariant.Flat" @onclick="HideDialog">OK</IgbButton>
    </IgbDialog>
</div>

@code {
    private bool IsOpen { get; set; } = true;

    private void ShowDialog() => IsOpen = true;

    private void HideDialog() => IsOpen = false;
}
