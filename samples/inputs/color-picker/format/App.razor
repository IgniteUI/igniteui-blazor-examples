@using IgniteUI.Blazor.Controls

<div class="container sample">
    <IgbColorPicker @ref="Picker" Format="ColorFormat.Rgb" Label="Pick a color" />
</div>

@code {
    private IgbColorPicker Picker;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Picker.EnsureReady();
            await Picker.ToggleAsync();
        }
    }
}
