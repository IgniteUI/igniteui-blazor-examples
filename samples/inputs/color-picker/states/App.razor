@using IgniteUI.Blazor.Controls

<div class="container sample">
    <div>
        <span>Default state</span>
        <IgbColorPicker @bind-Value="DefaultColor" Label="Pick a color" Open="true" />
    </div>
    <div>
        <span>Invalid state</span>
        <IgbColorPicker @ref="RequiredPicker" @bind-Value="RequiredColor" Required="true" Label="Pick a color" />
    </div>
    <div>
        <span>Disabled state</span>
        <IgbColorPicker TValue="string" Disabled="true" Label="Pick a color" />
    </div>
</div>

@code {
    private IgbColorPicker<string> RequiredPicker;
    private string DefaultColor;
    private string RequiredColor;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RequiredPicker.EnsureReady();
            await RequiredPicker.ReportValidityAsync();
        }
    }
}
