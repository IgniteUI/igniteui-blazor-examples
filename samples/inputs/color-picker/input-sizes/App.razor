@using IgniteUI.Blazor.Controls

<div class="container sample">
    <div>
        <span>Small</span>
        <IgbColorPicker class="smallPicker" @bind-Value="SmallColor" Mode="ColorPickerMode.Input" Label="Pick a color" Open="true" />
    </div>
    <div>
        <span>Medium</span>
        <IgbColorPicker class="mediumPicker" @bind-Value="MediumColor" Mode="ColorPickerMode.Input" Label="Pick a color" />
    </div>
    <div>
        <span>Large</span>
        <IgbColorPicker class="largePicker" @bind-Value="LargeColor" Mode="ColorPickerMode.Input" Label="Pick a color" />
    </div>
</div>

@code {
    private string SmallColor;
    private string MediumColor;
    private string LargeColor;
}
