
@using IgniteUI.Blazor.Controls


<div class="container vertical">
    <IgbRadioGroup TValue="string">
        <IgbRadio TValue="string" name="fruit" LabelPosition="ToggleLabelPosition.Before" Value="@("apple")">Apple</IgbRadio>
        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span id="radio-label">Orange</span>
            <IgbRadio TValue="string" name="fruit" AriaLabelledby="radio-label" Value="@("orange")"></IgbRadio>
        </div>
    </IgbRadioGroup>
</div>

