@using IgniteUI.Blazor.Controls


<style>
    igc-slider {
        padding: 30px 50px;
    }
</style>

<div class="container sample center">
    <IgbSlider PrimaryTicks="3"
        SecondaryTicks="4"
        ValueFormatOptions="@formatSpecifier">
    </IgbSlider>
    <IgbSlider ValueFormat="Storage: {0} GB"
        ValueFormatOptions="@formatSpecifier2">
    </IgbSlider>
</div>

@code {
    public IgbNumberFormatSpecifier formatSpecifier = new IgbNumberFormatSpecifier()
    {
        Style = "currency",
        Currency = "USD"
    };
    public IgbNumberFormatSpecifier formatSpecifier2 = new IgbNumberFormatSpecifier()
    {
        MinimumFractionDigits = 1
    };
}
