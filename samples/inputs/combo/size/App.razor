@using IgniteUI.Blazor.Controls

<div class="container sample">
    <div class="sizes">
        <span class="type-label"></span>
        @foreach (var size in Sizes)
        {
            <span class="state-label state-column">@size.Label</span>
        }
        @foreach (var type in Types)
        {
            <span class="state-label type-label @type.ClassName">@type.Label</span>
            @foreach (var combo in type.Combos)
            {
                <div class="size @combo.ClassName @type.ClassName">
                    <IgbCombo @ref="combo.ComboRef"
                              Value="combo.Value"
                              Change="@(() => OnChange(combo))"
                              Outlined="type.Outlined"
                              Placeholder="Country"
                              PlaceholderSearch="Search"
                              ValueKey="Id"
                              DisplayKey="Name"
                              GroupKey="Region"
                              Open="true"
                              ClosingScript="ComboKeepOpenOnOutsideClick"
                              Data="Countries" />
                    <div class="selection">
                        <span class="selection-title">Selection</span>
                        @if (combo.Value.Any())
                        {
                            @foreach (var id in combo.Value)
                            {
                                <span>@Countries.First(country => country.Id == id).Name</span>
                            }
                        }
                        else
                        {
                            <span class="selection-empty">No items selected</span>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private class Country
    {
        public string Id { get; set; }
        public string Name { get; set; }
        public string Region { get; set; }
    }

    private class ComboSize
    {
        public string Label { get; set; }
        public string ClassName { get; set; }
    }

    private class SizedCombo
    {
        public string ClassName { get; set; }
        public IgbCombo<string> ComboRef { get; set; }

        // the `Id` values of the selected countries
        public string[] Value { get; set; } = new string[] { };
    }

    private class ComboType
    {
        public string Label { get; set; }
        public bool Outlined { get; set; }
        public string ClassName { get; set; }

        // a combo of each size, and each combo binds a value of its own
        public List<SizedCombo> Combos { get; } = Sizes
            .Select(size => new SizedCombo { ClassName = size.ClassName })
            .ToList();
    }

    private List<Country> Countries { get; set; } = new List<Country>
    {
        new Country { Id = "BY", Name = "Belarus", Region = "Europe" },
        new Country { Id = "BE", Name = "Belgium", Region = "Europe" },
        new Country { Id = "BG", Name = "Bulgaria", Region = "Europe" },
    };

    private static List<ComboSize> Sizes { get; set; } = new List<ComboSize>
    {
        new ComboSize { Label = "Small", ClassName = "small" },
        new ComboSize { Label = "Medium", ClassName = "medium" },
        new ComboSize { Label = "Large", ClassName = "large" },
    };

    private List<ComboType> Types { get; set; } = new List<ComboType>
    {
        new ComboType { Label = "Border Type", Outlined = true, ClassName = "border-type" },
        new ComboType { Label = "Box Type", Outlined = false, ClassName = "box-type" },
    };

    // the value that the combo reports on a change starts with the last selected country, so the value is
    // read from the combo itself, which keeps the countries in the order of their selection
    private async Task OnChange(SizedCombo combo)
    {
        combo.Value = await combo.ComboRef.GetCurrentValueAsync();
    }
}
