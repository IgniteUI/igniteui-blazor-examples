@using IgniteUI.Blazor.Controls
@inject IJSRuntime JS

<div class="container sample">
    @* the combos are display-only, so inert blocks pointer and keyboard interaction *@
    <div class="states" inert>
        @foreach (var state in States)
        {
            @* the cell names the state that its display-only combo shows *@
            <div class="state" data-single-combo-shows="@state.Shows">
                <span class="state-label">@state.Label</span>
                <IgbCombo @bind-Value="state.Value"
                          class="state-combo"
                          SingleSelect="true"
                          Outlined="true"
                          Placeholder="Country"
                          ValueKey="Id"
                          DisplayKey="Name"
                          GroupKey="Region"
                          Open="state.Open"
                          ClosingScript="ComboKeepOpen"
                          Data="Countries" />
            </div>
        }
    </div>
</div>

@code {
    private class Country
    {
        public string Id { get; set; }
        public string Name { get; set; }
        public string Region { get; set; }
    }

    private class ComboState
    {
        public string Label { get; set; }
        // the state that the display-only combo shows: `:hover` or `:focus-within`
        public string Shows { get; set; }
        public string[] Value { get; set; }
        public bool Open { get; set; }
    }

    private List<Country> Countries { get; set; } = new List<Country>
    {
        new Country { Id = "BY", Name = "Belarus", Region = "Europe" },
        new Country { Id = "BE", Name = "Belgium", Region = "Europe" },
        new Country { Id = "BG", Name = "Bulgaria", Region = "Europe" },
    };

    private List<ComboState> States { get; set; } = new List<ComboState>
    {
        new ComboState { Label = "Idle", Value = new string[] { } },
        new ComboState { Label = "Idle & Hover", Shows = ":hover", Value = new string[] { } },
        new ComboState { Label = "Filled", Value = new string[] { "BY" } },
        new ComboState { Label = "Filled & Hover", Shows = ":hover", Value = new string[] { "BY" } },
        new ComboState { Label = "Focused", Shows = ":focus-within", Value = new string[] { "BY" } },
        new ComboState { Label = "Focused (Dropdown On)", Shows = ":focus-within", Value = new string[] { "BY" }, Open = true },
    };

    // The themes draw the hover and the focus of the combo with `:hover` and `:focus-within` rules, and a
    // display-only combo is never hovered or focused, so the script of the sample (events.js)
    // turns on those rules of the theme for the cells that name a state.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("showSingleSelectComboStates");
        }
    }
}
