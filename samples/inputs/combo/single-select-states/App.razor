@using IgniteUI.Blazor.Controls

<div class="container sample">
    @* the combos are display-only, so inert blocks keyboard interaction *@
    <div class="states" inert>
        @foreach (var state in States)
        {
            <div class="state">
                <span class="state-label">@state.Label</span>
                <IgbCombo @bind-Value="state.Value"
                          class="@($"state-combo {state.ClassName}")"
                          SingleSelect="true"
                          Outlined="true"
                          Placeholder="Country"
                          ValueKey="Id"
                          DisplayKey="Name"
                          GroupKey="Region"
                          Open="state.Open"
                          ClosingScript="ComboKeepOpen"
                          Data="Countries" />
            </div>
        }
    </div>
</div>

@code {
    private class Country
    {
        public string Id { get; set; }
        public string Name { get; set; }
        public string Region { get; set; }
    }

    private class ComboState
    {
        public string Label { get; set; }
        public string ClassName { get; set; } = "";
        public string[] Value { get; set; }
        public bool Open { get; set; }
    }

    private List<Country> Countries { get; set; } = new List<Country>
    {
        new Country { Id = "BY", Name = "Belarus", Region = "Europe" },
        new Country { Id = "BE", Name = "Belgium", Region = "Europe" },
        new Country { Id = "BG", Name = "Bulgaria", Region = "Europe" },
    };

    // hover and focus come from the pointer and the keyboard, so the `hover` and `focused`
    // classes show them on the display-only combos
    private List<ComboState> States { get; set; } = new List<ComboState>
    {
        new ComboState { Label = "Idle", Value = new string[] { } },
        new ComboState { Label = "Idle & Hover", ClassName = "hover", Value = new string[] { } },
        new ComboState { Label = "Filled", Value = new string[] { "BY" } },
        new ComboState { Label = "Filled & Hover", ClassName = "hover", Value = new string[] { "BY" } },
        new ComboState { Label = "Focused", ClassName = "focused", Value = new string[] { "BY" } },
        new ComboState { Label = "Focused (Dropdown On)", ClassName = "focused", Value = new string[] { "BY" }, Open = true },
    };
}
