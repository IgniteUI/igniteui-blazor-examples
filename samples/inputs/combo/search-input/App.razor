@using IgniteUI.Blazor.Controls
@inject IJSRuntime JS

<div class="container sample">
    @* the search inputs are display-only, so inert blocks pointer and keyboard interaction *@
    <div class="states" inert>
        @foreach (var state in States)
        {
            @* the cell names the state, the text, and the disabled state of its display-only search input *@
            <div class="state"
                 data-search-input
                 data-search-shows="@state.Shows"
                 data-search-text="@state.Text"
                 data-search-disabled="@state.Disabled">
                <span class="state-label">@state.Label</span>
                <IgbCombo @bind-Value="state.Value"
                          class="search"
                          PlaceholderSearch="Search"
                          Open="true"
                          ClosingScript="ComboKeepOpen"
                          Data="NoOptions" />
            </div>
        }
    </div>
</div>

@code {
    private class SearchState
    {
        public string Label { get; set; }
        // the state that the display-only search input shows: `:hover` or `:focus-within`
        public string Shows { get; set; }
        public bool Disabled { get; set; }
        // the search text of a filled search input
        public string Text { get; set; }
        public object[] Value { get; set; } = new object[] { };
    }

    private object[] NoOptions { get; set; } = new object[] { };

    private List<SearchState> States { get; set; } = new List<SearchState>
    {
        new SearchState { Label = "Idle" },
        new SearchState { Label = "Idle & Hover", Shows = ":hover" },
        new SearchState { Label = "Disabled", Disabled = true },
        new SearchState { Label = "Filled", Text = "Input text" },
        new SearchState { Label = "Filled & Hover", Shows = ":hover", Text = "Input text" },
        new SearchState { Label = "Focused", Shows = ":focus-within", Text = "Input text" },
    };

    // The search input is an input inside the combo, so the script of the sample (events.js) sets its text
    // and its disabled state. The themes draw its hover and its focus with `:hover` and `:focus-within`
    // rules, and a display-only search input is never hovered or focused, so the script also turns on
    // those rules of the theme for the cells that name a state.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("showComboSearchStates");
        }
    }
}
