@using IgniteUI.Blazor.Controls
@inject IJSRuntime JS

<div class="container sample">
    @* the search inputs are display-only, so inert blocks pointer and keyboard interaction *@
    <div class="states" inert>
        @foreach (var state in States)
        {
            @* the cell names the state that its display-only search input shows *@
            <div class="state" data-search-shows="@state.Shows">
                <span class="state-label">@state.Label</span>
                <IgbCombo @bind-Value="state.Value"
                          class="@($"search {state.ClassName}")"
                          PlaceholderSearch="@(state.Text ?? "Search")"
                          Open="true"
                          ClosingScript="ComboKeepOpen"
                          Data="NoOptions" />
            </div>
        }
    </div>
</div>

@code {
    private class SearchState
    {
        public string Label { get; set; }
        public string ClassName { get; set; } = "";
        // the state that the display-only search input shows: `:hover` or `:focus-within`
        public string Shows { get; set; }
        public string Text { get; set; }
        public object[] Value { get; set; } = new object[] { };
    }

    private object[] NoOptions { get; set; } = new object[] { };

    // the search input has no disabled or filled state of its own to set, so the `disabled` and
    // `filled` classes draw them
    private List<SearchState> States { get; set; } = new List<SearchState>
    {
        new SearchState { Label = "Idle" },
        new SearchState { Label = "Idle & Hover", Shows = ":hover" },
        new SearchState { Label = "Disabled", ClassName = "disabled" },
        new SearchState { Label = "Filled", ClassName = "filled", Text = "Input text" },
        new SearchState { Label = "Filled & Hover", ClassName = "filled", Shows = ":hover", Text = "Input text" },
        new SearchState { Label = "Focused", ClassName = "filled", Shows = ":focus-within", Text = "Input text" },
    };

    // The themes draw the hover and the focus of the search input with `:hover` and `:focus-within` rules, and a
    // display-only search input is never hovered or focused, so the script of the sample (events.js)
    // turns on those rules of the theme for the cells that name a state.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("showComboSearchStates");
        }
    }
}
