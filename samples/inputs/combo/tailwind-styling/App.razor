@using IgniteUI.Blazor.Controls

<div class="container sample flex h-full flex-row items-start justify-center">
    <IgbCombo @bind-Value="SelectedCountries"
              Outlined="true"
              Placeholder="Country"
              PlaceholderSearch="Search"
              ValueKey="Id"
              DisplayKey="Name"
              GroupKey="Region"
              Open="true"
              Data="Countries"
              class="w-[279px] [&_igc-combo]:[--item-count:4] [--ig-font-family:aktiv-grotesk,sans-serif] [--ig-input-group-border-color:var(--color-combo-border)] [--ig-input-group-hover-border-color:var(--color-combo-border)] [--ig-input-group-focused-border-color:var(--color-combo-border)] [--ig-input-group-filled-text-color:var(--color-combo-ink)] [--ig-input-group-focused-bottom-line-color:var(--color-combo-accent)] [--ig-combo-toggle-button-background:var(--color-combo-toggle)] [--ig-combo-toggle-button-background-focus:var(--color-combo-toggle)] [--ig-combo-toggle-button-background-focus--border:var(--color-combo-toggle)] [--ig-combo-toggle-button-foreground:var(--color-combo-ink)] [--ig-combo-toggle-button-foreground-focus:var(--color-combo-ink)] [--ig-combo-toggle-button-foreground-filled:var(--color-combo-ink)] [--ig-drop-down-elevation:none] [--ig-drop-down-background-color:var(--color-combo-surface)] [--ig-drop-down-header-text-color:var(--color-combo-header)] [--ig-drop-down-item-text-color:var(--color-combo-ink)] [--ig-drop-down-hover-item-background:var(--color-combo-toggle)] [--ig-drop-down-focused-item-background:var(--color-combo-toggle)] [--ig-drop-down-selected-item-background:var(--color-combo-selected)] [--ig-drop-down-selected-item-text-color:#000] [--ig-drop-down-selected-hover-item-background:var(--color-combo-selected)] [--ig-drop-down-selected-hover-item-text-color:#000] [--ig-drop-down-selected-focus-item-background:var(--color-combo-selected)] [--ig-drop-down-selected-focus-item-text-color:#000] [--ig-checkbox-empty-color:var(--color-combo-accent)] [--ig-checkbox-fill-color:var(--color-combo-accent)] [&_igc-combo::part(input)]:text-sm [&_igc-combo::part(input)]:font-medium [&_igc-combo::part(list-wrapper)]:rounded-t-none [&_igc-combo::part(list-wrapper)]:border [&_igc-combo::part(list-wrapper)]:border-solid [&_igc-combo::part(list-wrapper)]:border-t-0 [&_igc-combo::part(list-wrapper)]:border-[var(--color-combo-border)] [&_igc-combo::part(list-wrapper)]:pb-4 [&_igc-combo::part(item)]:font-medium [&_igc-combo::part(search-input)]:font-semibold" />
</div>

@code {
    private class Country
    {
        public string Id { get; set; }
        public string Name { get; set; }
        public string Region { get; set; }
    }

    private List<Country> Countries { get; set; } = new List<Country>
    {
        new Country { Id = "BY", Name = "Belarus", Region = "Europe" },
        new Country { Id = "BE", Name = "Belgium", Region = "Europe" },
        new Country { Id = "BG", Name = "Bulgaria", Region = "Europe" },
    };

    private string[] SelectedCountries { get; set; } = new string[] { "BY" };
}
