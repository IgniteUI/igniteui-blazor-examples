@using IgniteUI.Blazor.Controls

<div class="container sample">
    <div class="country">
        <IgbCombo @ref="ComboRef"
                  Value="SelectedCountries"
                  Change="OnChange"
                  class="styled-combo"
                  Outlined="true"
                  Placeholder="Country"
                  PlaceholderSearch="Search"
                  ValueKey="Id"
                  DisplayKey="Name"
                  GroupKey="Region"
                  Open="true"
                  Data="Countries" />
        <div class="selection">
            <span class="selection-title">Selection</span>
            @if (SelectedCountries.Any())
            {
                @foreach (var id in SelectedCountries)
                {
                    <span>@Countries.First(country => country.Id == id).Name</span>
                }
            }
            else
            {
                <span class="selection-empty">No items selected</span>
            }
        </div>
    </div>
</div>

@code {
    private class Country
    {
        public string Id { get; set; }
        public string Name { get; set; }
        public string Region { get; set; }
    }

    private List<Country> Countries { get; set; } = new List<Country>
    {
        new Country { Id = "BY", Name = "Belarus", Region = "Europe" },
        new Country { Id = "BE", Name = "Belgium", Region = "Europe" },
        new Country { Id = "BG", Name = "Bulgaria", Region = "Europe" },
    };

    // the `Id` values of the selected countries
    private string[] SelectedCountries { get; set; } = new string[] { "BY" };

    private IgbCombo<string> ComboRef { get; set; }

    // the value that the combo reports on a change starts with the last selected country, so the value is
    // read from the combo itself, which keeps the countries in the order of their selection
    private async Task OnChange()
    {
        this.SelectedCountries = await this.ComboRef.GetCurrentValueAsync();
    }
}
