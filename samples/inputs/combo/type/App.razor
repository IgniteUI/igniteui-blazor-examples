@using IgniteUI.Blazor.Controls

<div class="container sample">
    <div class="types">
        @foreach (var type in Types)
        {
            <div class="type @type.ClassName">
                <span class="type-label">@type.Label</span>
                <IgbCombo @ref="type.ComboRef"
                          Value="type.Value"
                          Change="@(() => OnChange(type))"
                          Outlined="type.Outlined"
                          Label="Label"
                          Placeholder="Select a value"
                          PlaceholderSearch="Search"
                          ValueKey="Id"
                          DisplayKey="Name"
                          GroupKey="Group"
                          Open="true"
                          ClosingScript="ComboKeepOpenOnOutsideClick"
                          Data="Options">
                    <IgbIcon slot="prefix" @ref="IconRef" IconName="language" Collection="material" />
                </IgbCombo>
                <div class="selection">
                    <span class="selection-title">Selection</span>
                    @if (type.Value.Any())
                    {
                        @foreach (var id in type.Value)
                        {
                            <span>@Options.First(option => option.Id == id).Name</span>
                        }
                    }
                    else
                    {
                        <span class="selection-empty">No items selected</span>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private const string LanguageIcon = """<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm6.93 6h-2.95c-.32-1.25-.78-2.45-1.38-3.56 1.84.63 3.37 1.91 4.33 3.56zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2 0 .68.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56-1.84-.63-3.37-1.9-4.33-3.56zm2.95-8H5.08c.96-1.66 2.49-2.93 4.33-3.56C8.81 5.55 8.35 6.75 8.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.09-.66-.16-1.32-.16-2 0-.68.07-1.35.16-2h4.68c.09.65.16 1.32.16 2 0 .68-.07 1.34-.16 2zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95c-.96 1.65-2.49 2.93-4.33 3.56zM16.36 14c.08-.66.14-1.32.14-2 0-.68-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z"/></svg>""";

    private class Option
    {
        public string Id { get; set; }
        public string Name { get; set; }
        public string Group { get; set; }
    }

    private class ComboType
    {
        public string Label { get; set; }
        public bool Outlined { get; set; }
        public string ClassName { get; set; }
        public IgbCombo<string> ComboRef { get; set; }

        // the `Id` values of the selected options
        public string[] Value { get; set; } = new string[] { };
    }

    private List<Option> Options { get; set; } = new[] { 1, 2, 3, 4, 5 }
        .Select(id => new Option { Id = $"{id}", Name = "Item", Group = "Header" })
        .ToList();

    private List<ComboType> Types { get; set; } = new List<ComboType>
    {
        new ComboType { Label = "Border Type", Outlined = true, ClassName = "border-type" },
        new ComboType { Label = "Box Type", Outlined = false, ClassName = "box-type" },
    };

    private IgbIcon IconRef { get; set; }

    // the value that the combo reports on a change starts with the last selected option, so the value is
    // read from the combo itself, which keeps the options in the order of their selection
    private async Task OnChange(ComboType type)
    {
        type.Value = await type.ComboRef.GetCurrentValueAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && this.IconRef != null)
        {
            await this.IconRef.EnsureReady();
            await this.IconRef.RegisterIconFromTextAsync("language", LanguageIcon, "material");
        }
    }
}
