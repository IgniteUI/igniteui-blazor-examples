@using IgniteUI.Blazor.Controls

<div class="container sample">
    <div class="sizes">
        @foreach (var size in Sizes)
        {
            <div class="size">
                <span class="state-label">@size.Label</span>
                <IgbCombo @ref="size.ComboRef"
                          Value="size.Value"
                          Change="@(() => OnChange(size))"
                          class="@($"dropdown {size.ClassName}")"
                          PlaceholderSearch="Search"
                          ValueKey="Id"
                          DisplayKey="Name"
                          GroupKey="Group"
                          Open="true"
                          ClosingScript="ComboKeepOpen"
                          Data="Options" />
                <div class="selection">
                    <span class="selection-title">Selection</span>
                    @if (size.Value.Any())
                    {
                        @foreach (var id in size.Value)
                        {
                            <span>@Options.First(option => option.Id == id).Name</span>
                        }
                    }
                    else
                    {
                        <span>No items selected</span>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private class Option
    {
        public string Id { get; set; }
        public string Name { get; set; }
        public string Group { get; set; }
    }

    private class DropdownSize
    {
        public string Label { get; set; }
        public string ClassName { get; set; }
        public IgbCombo<string> ComboRef { get; set; }

        // the `Id` values of the selected options
        public string[] Value { get; set; } = new string[] { };
    }

    private List<Option> Options { get; set; } = new[] { 1, 2, 3 }
        .Select(id => new Option { Id = $"{id}", Name = "Item", Group = "Header" })
        .ToList();

    private List<DropdownSize> Sizes { get; set; } = new List<DropdownSize>
    {
        new DropdownSize { Label = "Small", ClassName = "small" },
        new DropdownSize { Label = "Medium", ClassName = "medium" },
        new DropdownSize { Label = "Large", ClassName = "large" },
    };

    // the value that the combo reports on a change starts with the last selected option, so the value is
    // read from the combo itself, which keeps the options in the order of their selection
    private async Task OnChange(DropdownSize size)
    {
        size.Value = await size.ComboRef.GetCurrentValueAsync();
    }
}
