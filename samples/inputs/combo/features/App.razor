@using IgniteUI.Blazor.Controls

<div class="container sample combo-features">
    <div class="combo-column">
        <IgbCombo @bind-Value="selectedStates"
                  Data="usStates"
                  ValueKey="Id"
                  DisplayKey="Name"
                  Label="Location"
                  PlaceholderSearch="Search…"
                  Outlined
                  DisableFiltering="@disableFiltering"
                  CaseSensitiveIcon="@caseSensitiveIcon"
                  GroupKey="@groupKey"
                  Disabled="@disabled" />

        <div class="selection-panel">
            <span class="selection-title" id="selection-title">Selection</span>
            @if (selectedStates.Length > 0)
            {
                <ul class="selection-list" aria-labelledby="selection-title">
                    @foreach (var name in selectedNames)
                    {
                        <li>@name</li>
                    }
                </ul>
            }
            else
            {
                <span class="selection-empty">No items selected</span>
            }
        </div>
    </div>

    <div class="controls">
        <IgbSwitch @bind-Checked="disableFiltering">Disable Filtering</IgbSwitch>
        @* Without filtering the combo hides its search input, and the case-sensitive icon with it. *@
        <IgbSwitch @bind-Checked="caseSensitiveIcon" Disabled="@disableFiltering">Show Case-sensitive Icon</IgbSwitch>
        <IgbSwitch @bind-Checked="grouping">Enable Grouping</IgbSwitch>
        <IgbSwitch @bind-Checked="disabled">Disable Combo</IgbSwitch>
    </div>
</div>

@code {
    private List<UsState> usStates = UsStatesData.States;
    private string[] selectedStates = [];
    private bool disableFiltering;
    private bool caseSensitiveIcon;
    private bool grouping;
    private bool disabled;

    private string groupKey => grouping ? "Region" : "";

    // The names of the selected states, for the panel under the combo.
    private IEnumerable<string> selectedNames =>
        selectedStates.Select(id => usStates.FirstOrDefault(state => state.Id == id)?.Name ?? id);
}
