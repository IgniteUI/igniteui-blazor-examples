@using IgniteUI.Blazor.Controls

<div class="container sample">
    <div class="variants">
        <div id="arrow" class="target"></div>
        <div id="arrow-close" class="target"></div>
        <div id="no-arrow" class="target"></div>
        <div id="no-arrow-close" class="target"></div>
    </div>
    <IgbTooltip Anchor="arrow" Placement="PopoverPlacement.Top" WithArrow="true" HideTriggers="" Open="true">
        Tooltip message
    </IgbTooltip>
    <IgbTooltip Anchor="arrow-close" Placement="PopoverPlacement.Top" WithArrow="true" Sticky="true" Open="true">
        Tooltip message
    </IgbTooltip>
    <IgbTooltip Anchor="no-arrow" Placement="PopoverPlacement.Top" HideTriggers="" Open="true">
        Tooltip message
    </IgbTooltip>
    <IgbTooltip Anchor="no-arrow-close" Placement="PopoverPlacement.Top" Sticky="true" Open="true">
        Tooltip message
    </IgbTooltip>
</div>

