@using IgniteUI.Blazor.Controls
@inject IJSRuntime JS

<div class="container sample center" id="chip-outlined" style="flex-direction: row; gap: 8px">
    @if (ShowDefault)
    {
        <IgbChip Outlined="true" Selectable="true" Removable="true" Remove="@RemoveDefault">
            Default
        </IgbChip>
    }

    @foreach (var variant in Variants)
    {
        <IgbChip @key="variant" Outlined="true" Variant="@variant" Selectable="true" Removable="true" Remove="@(() => RemoveVariant(variant))">
            @variant
        </IgbChip>
    }
</div>

@code {
    private bool ShowDefault = true;
    private readonly List<StyleVariant> Variants = new List<StyleVariant>
    {
        StyleVariant.Primary,
        StyleVariant.Info,
        StyleVariant.Success,
        StyleVariant.Warning,
        StyleVariant.Danger
    };
    private int? RemovedIndex;

    private void RemoveDefault()
    {
        RemovedIndex = 0;
        ShowDefault = false;
    }

    private void RemoveVariant(StyleVariant variant)
    {
        RemovedIndex = (ShowDefault ? 1 : 0) + Variants.IndexOf(variant);
        Variants.Remove(variant);
    }

    // The removed chip is gone, so move focus to the chip that took its place, or the one before it.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (RemovedIndex is int index)
        {
            RemovedIndex = null;
            await JS.InvokeVoidAsync("chipOutlinedSample.focusAfterRemove", index);
        }
    }
}