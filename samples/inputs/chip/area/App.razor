@using IgniteUI.Blazor.Controls

<div class="container sample chips-area-sample">
    <div class="chips-area">
        @foreach (var label in Chips)
        {
            <IgbChip>@label</IgbChip>
        }
    </div>
</div>

@code {
    private readonly string[] Chips = { "Chip", "Chip", "Chip" };
}
