@using IgniteUI.Blazor.Controls

<link href="_content/IgniteUI.Blazor/themes/light/material.css" rel="stylesheet" />

<div class="button-group-interaction-states">
    <div class="button-group-interaction-states-row">
        <span class="row-label"></span>
        <span class="column-label">Enabled</span>
        <span class="column-label">Disabled</span>
    </div>
    @foreach (var row in Rows)
    {
        <div class="button-group-interaction-states-row">
            <span class="row-label">@row.Label</span>
            <IgbButtonGroup Selection="ButtonGroupSelection.Multiple">
                <IgbToggleButton Value="device" Selected="@(row.Label == "Selected / On")">
                    Device
                    <IgbRipple />
                </IgbToggleButton>
            </IgbButtonGroup>
            <IgbButtonGroup Selection="ButtonGroupSelection.Multiple" Disabled="true">
                <IgbToggleButton Value="cloud" Selected="@row.Selected">
                    Cloud
                </IgbToggleButton>
            </IgbButtonGroup>
        </div>
    }
</div>

@code {
    private record StateRow(string Label, bool Selected);

    private static readonly StateRow[] Rows =
    {
        new StateRow("Selected / Off", false),
        new StateRow("Selected / On", true)
    };
}
